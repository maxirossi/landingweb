[Unit]
Description=MateLabs landing - API de contacto
After=network.target

[Service]
User=mateapp
WorkingDirectory=/opt/matelabs/apps/matelabs-landing/contact-server
EnvironmentFile=/opt/matelabs/apps/matelabs-landing/contact-server/.env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
