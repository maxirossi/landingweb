import ServicesSection from '../components/sections/ServicesSection.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import ContactWidget from '../components/ContactWidget.astro';
---

<Layout
  title="MateLabs — Software a medida, productos digitales e inteligencia artificial"
  description="Estudio de software en Rosario, Argentina. Desarrollo web, plataformas SaaS, integración de IA y automatización para negocios reales."
>
  <Header />

  <main>
    <HeroSection />
    <ServicesSection />
    <ProcessSection />
    <ContactSection />
