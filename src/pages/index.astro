---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import PortfolioSection from '../components/sections/PortfolioSection.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import NeedsSection from '../components/sections/NeedsSection.astro';
import CaseSection from '../components/sections/CaseSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import { homeJsonLd, faqPage } from '../lib/structuredData';
import { faqs } from '../config/home';
import ContactWidget from '../components/ContactWidget.astro';
---

<Layout
  title="MateLabs — Software a medida, productos digitales e inteligencia artificial"
  description="Estudio de software en Rosario, Argentina. Desarrollo web, plataformas SaaS, integración de IA y automatización para negocios reales."
  jsonLd={[homeJsonLd(), { '@context': 'https://schema.org', ...faqPage(faqs.map((f) => [f.q.es, f.a.es])) }]}
>
  <Header />

  <main>
    <HeroSection />
    <PortfolioSection />
    <NeedsSection />
    <ServicesSection />
    <CaseSection />
    <ProcessSection />
    <FaqSection />
    <CtaBand />
    <ContactSection />
  </main>

  <Footer />
  <ContactWidget />
</Layout>
