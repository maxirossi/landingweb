---
import { translations } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = translations.es.metaTitle,
  description = translations.es.metaDescription
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#030712" />
  <meta name="color-scheme" content="dark" />
  <meta name="robots" content="index, follow" />

  <title>{title}</title>
  <meta name="description" content={description} data-i18n-meta="description" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} data-i18n-meta="og:title" />
  <meta property="og:description" content={description} data-i18n-meta="og:description" />
  <meta property="og:locale" content="es_AR" />
  <meta property="og:site_name" content="MateLabs" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} data-i18n-meta="twitter:title" />
  <meta name="twitter:description" content={description} data-i18n-meta="twitter:description" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <style is:global>
    @import '../styles/global.css';
  </style>
</head>
<body>
  <slot />

  <script define:vars={{ translations }}>
    (function () {
      const MESSAGES = translations;
      const LOCALES = ['es', 'en'];

      function normalize(locale) {
        return LOCALES.includes(locale) ? locale : 'es';
      }

      function applyLocale(locale) {
        const lang = normalize(locale);
        const dict = MESSAGES[lang];
        if (!dict) return;

        document.documentElement.lang = lang;

        // Text content
        document.querySelectorAll('[data-i18n]').forEach((node) => {
          const key = node.getAttribute('data-i18n');
          if (key && dict[key]) node.textContent = dict[key];
        });

        // Placeholders
        document.querySelectorAll('[data-i18n-placeholder]').forEach((node) => {
          const key = node.getAttribute('data-i18n-placeholder');
          if (key && dict[key]) node.setAttribute('placeholder', dict[key]);
        });

        // Meta tags
        document.title = dict.metaTitle || document.title;
        const metaMap = {
          description: dict.metaDescription,
          'og:title': dict.metaTitle,
          'og:description': dict.metaDescription,
          'twitter:title': dict.metaTitle,
          'twitter:description': dict.metaDescription,
        };
        Object.entries(metaMap).forEach(([k, v]) => {
          const meta = document.querySelector(`[data-i18n-meta="${k}"]`);
          if (meta && v) meta.setAttribute('content', v);
        });

        // Language switcher active state
        document.querySelectorAll('[data-lang-switch]').forEach((btn) => {
          const active = btn.getAttribute('data-lang-switch') === lang;
          btn.classList.toggle('bg-white/10', active);
        });

        localStorage.setItem('matelabs-lang', lang);
      }

      // Init
      const stored = localStorage.getItem('matelabs-lang');
      const browser = (navigator.language || 'es').slice(0, 2);
      applyLocale(stored || browser || 'es');

      // Listeners
      document.querySelectorAll('[data-lang-switch]').forEach((btn) => {
        btn.addEventListener('click', () => {
          applyLocale(btn.getAttribute('data-lang-switch'));
        });
      });

      // Scroll reveal
      const els = document.querySelectorAll('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -10% 0px' }
      );
      els.forEach((el) => io.observe(el));
    })();
  </script>
</body>
</html>
