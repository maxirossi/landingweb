---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import { servicios, proyectos } from '../config/nav';

const currentYear = new Date().getFullYear();

---

<footer class="border-t border-white/[0.06]" style="background: rgba(3,7,18,0.8);">
  <div class="container-safe py-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr] gap-8">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <Logo />
        <p class="mt-3 text-sm text-slate-400 max-w-sm" data-i18n="footerDesc">
          Software a medida, productos digitales e inteligencia artificial aplicada a negocios reales.
        </p>
        <ul class="mt-4 space-y-2 text-sm text-slate-400">
          <li class="flex items-center gap-2"><Icon name="mail" class="w-5 h-5 shrink-0 text-slate-500" /><a href="mailto:hola@matelabs.com.ar" class="hover:text-white transition-colors">hola@matelabs.com.ar</a></li>
          <li class="flex items-center gap-2"><svg class="w-5 h-5 shrink-0 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/></svg><a href="https://www.instagram.com/matelabs.ok/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">@matelabs.ok</a></li>
          <li class="flex items-center gap-2"><Icon name="pin" class="w-5 h-5 shrink-0 text-slate-500" /><span>Rosario, Argentina</span></li>
        </ul>
      </div>

      <!-- Enlaces -->
      <nav aria-label="Servicios"><h4 class="text-sm font-semibold text-slate-200 mb-3" data-i18n="footerServices">Servicios</h4>
        <ul class="space-y-2">{servicios.map((i) => <li><a href={i.href} class="text-sm text-slate-400 hover:text-white transition-colors" data-i18n={i.key}>{i.label}</a></li>)}</ul>
      </nav>
      <nav aria-label="Proyectos y empresa"><h4 class="text-sm font-semibold text-slate-200 mb-3" data-i18n="footerProjects">Proyectos</h4>
        <ul class="space-y-2">{proyectos.map((i) => <li><a href={i.href} target="_blank" rel="noopener" class="text-sm text-slate-400 hover:text-white transition-colors" data-i18n={i.key}>{i.label}</a></li>)}</ul>
        <h4 class="text-sm font-semibold text-slate-200 mt-6 mb-3" data-i18n="footerCompany">Empresa</h4>
        <ul class="space-y-2">
          <li><a href="/nosotros/" class="text-sm text-slate-400 hover:text-white transition-colors" data-i18n="navAbout">Nosotros</a></li>
          <li><a href="/#proceso" class="text-sm text-slate-400 hover:text-white transition-colors" data-i18n="navProcess">Proceso</a></li>
          <li><a href="/#contacto" class="text-sm text-slate-400 hover:text-white transition-colors" data-i18n="navContact">Contactar</a></li>
        </ul>
      </nav>
    </div>

    <div class="mt-10 pt-6 border-t border-slate-800/60 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-slate-500">
        &copy; {currentYear} MateLabs. <span data-i18n="footerRights">Todos los derechos reservados.</span>
      </p>
      <div class="flex items-center gap-4">
        <a href="https://www.linkedin.com/company/matelabsar/" target="_blank" rel="noopener noreferrer" class="grid h-10 w-10 place-items-center rounded-lg text-[#2d9cf4] hover:text-[#5ab4f7] hover:bg-white/[0.06] transition-colors" aria-label="LinkedIn (se abre en una pestaña nueva)">
          <BrandIcon name="linkedin" class="w-5 h-5" />
        </a>
        <a href="https://www.instagram.com/matelabs.ok/" target="_blank" rel="noopener noreferrer" class="grid h-10 w-10 place-items-center rounded-lg text-[#E1306C] hover:text-[#f0638f] hover:bg-white/[0.06] transition-colors" aria-label="Instagram de MateLabs (se abre en una pestaña nueva)"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/></svg></a>
        <a href="https://www.facebook.com/matelabs.ok" target="_blank" rel="noopener noreferrer" class="grid h-10 w-10 place-items-center rounded-lg text-[#4c9bf5] hover:text-[#79b4f8] hover:bg-white/[0.06] transition-colors" aria-label="Facebook de MateLabs (se abre en una pestaña nueva)"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg></a>
      </div>
    </div>
  </div>
</footer>
