---
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();

const navLinks = [
  { label: 'Servicios', key: 'navServices', href: '#servicios' },
  { label: 'Proyectos', key: 'navProjects', href: '#proyectos' },
  { label: 'Proceso', key: 'navProcess', href: '#proceso' },
  { label: 'Contacto', key: 'navContact', href: '#contacto' },
];

const projects = [
  { label: 'OctoMateLabs', href: 'https://octomatelabs.site' },
  { label: 'QueriCoRosario', href: 'https://quericorosario.com' },
];
---

<footer class="border-t border-white/[0.06]" style="background: rgba(3,7,18,0.8);">
  <div class="container-safe py-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <Logo />
        <p class="mt-3 text-sm text-slate-400 max-w-sm" data-i18n="footerDesc">
          Software a medida, productos digitales e inteligencia artificial aplicada a negocios reales.
        </p>
      </div>

      <!-- Nav -->
      <div>
        <h4 class="text-sm font-semibold text-slate-200 mb-3" data-i18n="footerNav">Navegación</h4>
        <ul class="space-y-2">
          {navLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-slate-400 hover:text-white transition-colors" data-i18n={link.key}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Projects -->
      <div>
        <h4 class="text-sm font-semibold text-slate-200 mb-3" data-i18n="footerProjects">Proyectos</h4>
        <ul class="space-y-2">
          {projects.map(link => (
            <li>
              <a
                href={link.href}
                class="text-sm text-slate-400 hover:text-white transition-colors"
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-slate-800/60 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-slate-500">
        &copy; {currentYear} MateLabs. <span data-i18n="footerRights">Todos los derechos reservados.</span>
      </p>
      <div class="flex items-center gap-4">
        <a href="https://www.linkedin.com/company/matelabsar/" target="_blank" rel="noopener noreferrer" class="text-[#2d9cf4] hover:text-[#5ab4f7] transition-colors" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <p class="text-xs text-slate-500">
          Rosario, Argentina
        </p>
      </div>
    </div>
  </div>
</footer>
