---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';

const currentYear = new Date().getFullYear();

const navLinks = [
  { label: 'Servicios', key: 'navServices', href: '#servicios' },
  { label: 'Proceso', key: 'navProcess', href: '#proceso' },
  { label: 'Contacto', key: 'navContact', href: '#contacto' },
];
---

<footer class="border-t border-white/[0.06]" style="background: rgba(3,7,18,0.8);">
  <div class="container-safe py-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <Logo />
        <p class="mt-3 text-sm text-slate-400 max-w-sm" data-i18n="footerDesc">
          Software a medida, productos digitales e inteligencia artificial aplicada a negocios reales.
        </p>
        <ul class="mt-4 space-y-2 text-sm text-slate-400">
          <li class="flex items-center gap-2"><Icon name="mail" class="w-5 h-5 shrink-0 text-slate-500" /><a href="mailto:hola@matelabs.com.ar" class="hover:text-white transition-colors">hola@matelabs.com.ar</a></li>
          <li class="flex items-center gap-2"><Icon name="pin" class="w-5 h-5 shrink-0 text-slate-500" /><span>Rosario, Argentina</span></li>
        </ul>
      </div>

      <!-- Nav -->
      <div>
        <h4 class="text-sm font-semibold text-slate-200 mb-3" data-i18n="footerNav">Navegación</h4>
        <ul class="space-y-2">
          {navLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-slate-400 hover:text-white transition-colors" data-i18n={link.key}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-slate-800/60 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-slate-500">
        &copy; {currentYear} MateLabs. <span data-i18n="footerRights">Todos los derechos reservados.</span>
      </p>
      <div class="flex items-center gap-4">
        <a href="https://www.linkedin.com/company/matelabsar/" target="_blank" rel="noopener noreferrer" class="grid h-10 w-10 place-items-center rounded-lg text-[#2d9cf4] hover:text-[#5ab4f7] hover:bg-white/[0.06] transition-colors" aria-label="LinkedIn (se abre en una pestaña nueva)">
          <BrandIcon name="linkedin" class="w-5 h-5" />
        </a>
      </div>
    </div>
  </div>
</footer>
