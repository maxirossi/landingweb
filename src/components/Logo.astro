---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<a href="/" class:list={['flex items-center gap-2.5 group', className]} aria-label="MateLabs, inicio">
  <!-- Robot mascot as logo -->
  <img
    src="/images/mascota.webp"
    alt=""
    width="32"
    height="32"
    class="w-7 h-7 sm:w-8 sm:h-8 flex-shrink-0 rounded-full object-cover"
    
  />
  <!-- Wordmark -->
  <span class="text-xl sm:text-2xl font-bold text-ink-text" style="letter-spacing:-.05em">MateLabs<span class="text-brand">.</span></span>
</a>
