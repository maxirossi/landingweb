---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import { servicios, proyectos, recursos, nosotros } from '../config/nav';
---
<header id="navbar" class="fixed top-0 left-0 right-0 z-50 navbar-glass">
  <div class="container-safe flex items-center justify-between h-16 navbar-inner">
    <Logo />

    <!-- Desktop Nav con menús expandibles -->
    <nav class="dnav hidden lg:flex items-center gap-1" aria-label="Principal">
      <div class="dnav__item">
        <button type="button" class="dnav__trigger" data-mega="servicios" aria-expanded="false" aria-controls="mega-servicios"><span data-i18n="navServices">Servicios</span> <Icon name="chevron" /></button>
        <a class="dnav__link dnav__nojs" href="/servicios/" data-i18n="navServices">Servicios</a>
      </div>
      <div class="dnav__item">
        <button type="button" class="dnav__trigger" data-mega="proyectos" aria-expanded="false" aria-controls="mega-proyectos"><span data-i18n="navProjects">Proyectos</span> <Icon name="chevron" /></button>
        <a class="dnav__link dnav__nojs" href="https://mateturnos.site/" data-i18n="navProjects">Proyectos</a>
      </div>
      <div class="dnav__item">
        <button type="button" class="dnav__trigger" data-mega="recursos" aria-expanded="false" aria-controls="mega-recursos"><span data-i18n="navResources">Recursos</span> <Icon name="chevron" /></button>
        <a class="dnav__link dnav__nojs" href="/#proceso" data-i18n="navResources">Recursos</a>
      </div>
      <a class="dnav__link" href={nosotros.href} data-i18n={nosotros.key}>{nosotros.label}</a>
    </nav>

    <div class="flex items-center gap-3">
      <!-- LinkedIn -->
      <a href="https://www.linkedin.com/company/matelabsar/" target="_blank" rel="noopener noreferrer" class="grid h-10 w-10 place-items-center rounded-lg text-[#2d9cf4] hover:text-[#5ab4f7] hover:bg-white/[0.06] transition-colors duration-200" aria-label="LinkedIn (se abre en una pestaña nueva)">
        <BrandIcon name="linkedin" class="w-5 h-5" />
      </a>
      <a href="https://www.instagram.com/matelabs.ok/" target="_blank" rel="noopener noreferrer" class="grid h-10 w-10 place-items-center rounded-lg text-[#E1306C] hover:text-[#f0638f] hover:bg-white/[0.06] transition-colors" aria-label="Instagram de MateLabs (se abre en una pestaña nueva)"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/></svg></a>
      <a href="https://www.facebook.com/matelabs.ok" target="_blank" rel="noopener noreferrer" class="grid h-10 w-10 place-items-center rounded-lg text-[#4c9bf5] hover:text-[#79b4f8] hover:bg-white/[0.06] transition-colors" aria-label="Facebook de MateLabs (se abre en una pestaña nueva)"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg></a>

      <!-- Language Switcher -->
      <div class="hidden sm:flex items-center gap-1 rounded-lg border border-white/[0.06] p-1 text-slate-300" style="background: rgba(255,255,255,0.04);" role="group" aria-label="Idioma">
        <Icon name="globe" class="w-4 h-4 mx-1 text-slate-400" />
        <button class="h-8 min-w-9 px-1.5 grid place-items-center rounded text-xs font-semibold tracking-wide hover:bg-white/10 transition-colors duration-200 bg-white/10" data-lang-switch="es" lang="es" aria-label="Castellano">ES</button>
        <button class="h-8 min-w-9 px-1.5 grid place-items-center rounded text-xs font-semibold tracking-wide hover:bg-white/10 transition-colors duration-200" data-lang-switch="en" lang="en" aria-label="English">EN</button>
      </div>

      <!-- CTA -->
      <a href="/#contacto" class="btn btn-primary btn-sm" data-i18n="navContact">
        Contactar
      </a>

      <!-- Mobile Menu Button -->
      <button id="menu-toggle" type="button" class="lg:hidden grid h-10 w-10 place-items-center rounded-lg text-slate-300 hover:text-white hover:bg-white/[0.06] transition-colors duration-200" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" class="w-6 h-6 menu-open" />
        <Icon name="close" class="w-6 h-6 menu-close hidden" />
      </button>
    </div>
  </div>

  <!-- Mega: Servicios -->
  <div class="mega hidden-mega" id="mega-servicios" hidden>
    <div class="container-safe mega__inner mega__cols-servicios">
      <ul class="mega__list">
        {servicios.map((i) => (
          <li><a class="mega__opt" href={i.href}>
            <span class="mega__icon"><Icon name={i.icon!} /></span>
            <span><strong data-i18n={i.key}>{i.label}</strong><span class="d" data-i18n={i.descKey}>{i.desc}</span></span>
          </a></li>
        ))}
      </ul>
      <aside class="mega__aside">
        <p class="mega__aside-title" data-i18n="mmHelpTitle">¿Todavía no tenés el proyecto definido?</p>
        <p class="mega__aside-text" data-i18n="mmHelpText">Contanos la idea y vemos juntos cómo avanzar.</p>
        <a class="btn btn-primary btn-sm mt-4" href="/#contacto" data-i18n="mmHelpCta">Contanos tu idea</a>
        <a class="mega__more" href="/servicios/"><span data-i18n="mmAllSvc">Ver todos los servicios</span> <Icon name="arrow" class="w-4 h-4" /></a>
      </aside>
    </div>
  </div>

  <!-- Mega: Proyectos -->
  <div class="mega hidden-mega" id="mega-proyectos" hidden>
    <div class="container-safe mega__inner mega__cols-2">
      <ul class="mega__list mega__list--2">
        {proyectos.map((i) => (
          <li><a class="mega__opt" href={i.href} target="_blank" rel="noopener">
            <span class="mega__icon"><Icon name="external" /></span>
            <span><strong data-i18n={i.key}>{i.label}</strong><span class="d" data-i18n={i.descKey}>{i.desc}</span></span>
          </a></li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Mega: Recursos -->
  <div class="mega hidden-mega" id="mega-recursos" hidden>
    <div class="container-safe mega__inner mega__cols-2">
      <ul class="mega__list mega__list--2">
        {recursos.map((i) => (
          <li><a class="mega__opt" href={i.href} {...(i.external ? { target: '_blank', rel: 'noopener' } : {})}>
            <span><strong data-i18n={i.key}>{i.label}</strong><span class="d" data-i18n={i.descKey}>{i.desc}</span></span>
          </a></li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Mobile Nav -->
  <nav id="mobile-menu" class="hidden lg:hidden mnav" aria-label="Principal (móvil)">
    <div class="container-safe pt-2">
      <details>
        <summary><span data-i18n="navServices">Servicios</span> <Icon name="chevron" /></summary>
        <div class="pb-3">{servicios.map((i) => <a class="m mobile-nav-link" href={i.href} data-i18n={i.key}>{i.label}</a>)}</div>
      </details>
      <details>
        <summary><span data-i18n="navProjects">Proyectos</span> <Icon name="chevron" /></summary>
        <div class="pb-3">{proyectos.map((i) => <a class="m mobile-nav-link" href={i.href} target="_blank" rel="noopener" data-i18n={i.key}>{i.label}</a>)}</div>
      </details>
      <details>
        <summary><span data-i18n="navResources">Recursos</span> <Icon name="chevron" /></summary>
        <div class="pb-3">{recursos.map((i) => <a class="m mobile-nav-link" href={i.href} {...(i.external ? { target: '_blank', rel: 'noopener' } : {})} data-i18n={i.key}>{i.label}</a>)}</div>
      </details>
      <a class="top mobile-nav-link" href={nosotros.href} data-i18n={nosotros.key}>{nosotros.label}</a>
      <!-- Mobile language switcher -->
      <div class="flex items-center gap-2 mt-3 py-3 border-t border-white/[0.06]">
        <Icon name="globe" class="w-5 h-5 text-slate-400" />
        <button class="h-10 min-w-11 px-2 grid place-items-center rounded text-sm font-semibold text-slate-200 bg-white/10 hover:bg-white/15 transition-colors duration-200" data-lang-switch="es" lang="es" aria-label="Castellano">ES</button>
        <button class="h-10 min-w-11 px-2 grid place-items-center rounded text-sm font-semibold text-slate-200 hover:bg-white/10 transition-colors duration-200" data-lang-switch="en" lang="en" aria-label="English">EN</button>
      </div>
    </div>
  </nav>
</header>
<noscript><style>.dnav__trigger{display:none!important}.dnav__nojs{display:inline-flex!important}</style></noscript>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const setOpen = (open) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      toggle.querySelector('.menu-open')?.classList.toggle('hidden', open);
      toggle.querySelector('.menu-close')?.classList.toggle('hidden', !open);
    };
    toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    menu.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => setOpen(false));
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.classList.contains('hidden')) { setOpen(false); toggle.focus(); } });
  }


  // Menús expandibles (escritorio): un panel a la vez, Escape, clic fuera y foco que sale.
  const header = document.getElementById('navbar');
  if (header) {
    const triggers = [...header.querySelectorAll('[data-mega]')];
    const panelOf = (t) => document.getElementById(t.getAttribute('aria-controls'));
    const closeMega = (except) => triggers.forEach((t) => {
      if (t !== except) { t.setAttribute('aria-expanded', 'false'); panelOf(t).hidden = true; }
    });
    triggers.forEach((t) => t.addEventListener('click', () => {
      const wasOpen = t.getAttribute('aria-expanded') === 'true';
      closeMega();
      if (!wasOpen) { t.setAttribute('aria-expanded', 'true'); panelOf(t).hidden = false; }
    }));
    header.querySelectorAll('.mega a').forEach((a) => a.addEventListener('click', () => closeMega()));
    document.addEventListener('click', (e) => { if (!header.contains(e.target)) closeMega(); });
    header.addEventListener('focusout', (e) => { if (e.relatedTarget && !header.contains(e.relatedTarget)) closeMega(); });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = triggers.find((t) => t.getAttribute('aria-expanded') === 'true');
      if (open) { closeMega(); open.focus(); }
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', () => closeMega());
  }

  const navbar = document.getElementById('navbar');
  if (navbar) {
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          navbar.classList.toggle('is-scrolled', window.scrollY > 32);
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }
</script>
