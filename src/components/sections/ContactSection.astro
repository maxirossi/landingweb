<section id="contacto" class="section relative overflow-hidden">
  <div class="bg-orb w-[400px] h-[400px] -bottom-20 -right-20 bg-brand/[0.07]" style="animation-delay: 4s;"></div>
  <div class="bg-orb w-[300px] h-[300px] -top-10 -left-20 bg-accent/[0.05]" style="animation-delay: 7s;"></div>

  <div class="container-safe relative z-10">
    <div class="max-w-3xl mx-auto">
      <div data-reveal class="cta-card card text-center py-10 px-6 sm:px-12 relative overflow-hidden">
        <!-- Background glow -->
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[400px] h-[200px] rounded-full" style="background: radial-gradient(ellipse, rgba(20,184,166,0.08) 0%, transparent 70%);"></div>
        </div>

        <div class="relative z-10">
          <!-- Mini robot -->
          <div data-reveal class="mb-5">
            <img
              src="/images/robot.png"
              alt=""
              width="64"
              height="64"
              class="w-16 h-16 mx-auto object-contain"
              style="filter: drop-shadow(0 0 12px rgba(20,184,166,0.3));"
              aria-hidden="true"
            />
          </div>

          <h2 class="text-3xl sm:text-4xl font-semibold text-white" data-i18n="contactTitle">
            Tenés un proyecto en mente?
          </h2>
          <p class="mt-4 text-slate-400 max-w-lg mx-auto" data-i18n="contactSubtitle">
            Contanos qué querés construir y vemos cómo hacerlo realidad.
          </p>

          <form id="contact-form" class="mt-10 max-w-md mx-auto space-y-4 text-left">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-sm font-medium text-slate-300 mb-1.5" data-i18n="contactName">Nombre</label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  class="w-full px-4 py-2.5 bg-slate-900/80 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition-all duration-200"
                  placeholder="Tu nombre"
                  data-i18n-placeholder="contactNamePlaceholder"
                />
              </div>
              <div>
                <label for="contact-email" class="block text-sm font-medium text-slate-300 mb-1.5" data-i18n="contactEmail">Email</label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  class="w-full px-4 py-2.5 bg-slate-900/80 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition-all duration-200"
                  placeholder="tu@email.com"
                  data-i18n-placeholder="contactEmailPlaceholder"
                />
              </div>
            </div>

            <div>
              <label for="contact-message" class="block text-sm font-medium text-slate-300 mb-1.5" data-i18n="contactMessage">Mensaje</label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                required
                class="w-full px-4 py-2.5 bg-slate-900/80 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition-all duration-200 resize-none"
                placeholder="Contanos sobre tu proyecto o idea..."
                data-i18n-placeholder="contactMessagePlaceholder"
              ></textarea>
            </div>

            <button type="submit" id="contact-submit" class="btn btn-primary btn-lg w-full group">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
              </svg>
              <span data-i18n="contactSend">Enviar mensaje</span>
            </button>

            <p id="contact-status" class="hidden text-sm text-center mt-2"></p>
          </form>

          <p class="mt-6 text-xs text-slate-500">
            <span data-i18n="contactAlt">También podés escribirnos directamente a</span> <a href="mailto:hola@matelabs.com.ar" class="text-brand hover:underline transition-colors duration-200">hola@matelabs.com.ar</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-card {
    background: linear-gradient(135deg, rgba(20,184,166,0.06) 0%, rgba(34,211,238,0.03) 40%, rgba(139,92,246,0.05) 100%) !important;
    border-color: rgba(20,184,166,0.1) !important;
    box-shadow: 0 8px 40px rgba(0,0,0,0.3), 0 0 60px rgba(20,184,166,0.04), inset 0 1px 0 rgba(255,255,255,0.04) !important;
  }
</style>

<script>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('contact-status');
  const submitBtn = document.getElementById('contact-submit');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.classList.add('hidden');
      submitBtn.disabled = true;
      const origHTML = submitBtn.innerHTML;
      submitBtn.innerHTML = '<span class="animate-pulse">...</span>';

      const body = {
        name: form.querySelector('[name="name"]').value,
        email: form.querySelector('[name="email"]').value,
        message: form.querySelector('[name="message"]').value,
        topic: '',
        source: 'formulario',
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });

        if (res.ok) {
          status.textContent = document.documentElement.lang === 'en'
            ? 'Message sent successfully!'
            : 'Mensaje enviado correctamente!';
          status.className = 'text-sm text-center mt-2 text-brand';
          form.reset();
        } else if (res.status === 429) {
          status.textContent = document.documentElement.lang === 'en'
            ? 'Too many attempts. Try again in a few minutes.'
            : 'Demasiados intentos. Intentá de nuevo en unos minutos.';
          status.className = 'text-sm text-center mt-2 text-amber-400';
        } else {
          throw new Error();
        }
      } catch {
        status.textContent = document.documentElement.lang === 'en'
          ? 'Something went wrong. Try again or email us directly.'
          : 'Algo salió mal. Intentá de nuevo o escribinos directamente.';
        status.className = 'text-sm text-center mt-2 text-red-400';
      }

      status.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.innerHTML = origHTML;
    });
  }
</script>
