---
import { CONTACT_EMAIL, WHATSAPP_URL, WHATSAPP_DISPLAY } from '../../config/contact';
import Icon from '../Icon.astro';
const topics = [
  ['Software a medida', 'ctTopic1', 'Software a medida'],
  ['Plataforma o app', 'ctTopic2', 'Plataforma web o app móvil'],
  ['IA y automatización', 'ctTopic3', 'IA y automatización'],
  ['Otro', 'ctTopic4', 'Otro / todavía no sé'],
];
---
<section id="contacto" class="contact on-light" aria-labelledby="ct-title">
  <div class="container-safe ct-grid">
    <div>
      <p class="eyebrow" data-i18n="contactEyebrow">07 / Conversemos</p>
      <h2 id="ct-title" class="display mt-3.5" data-i18n="contactTitle">¿Qué vamos a construir juntos?</h2>
      <p class="ct-lead" data-i18n="contactSubtitle">Contanos tu idea, aunque todavía no tengas todos los detalles definidos. Te respondemos con los próximos pasos.</p>
      <ul class="ct-direct">
        <li><a href={`${WHATSAPP_URL}?text=${encodeURIComponent('Hola MateLabs, quiero consultar por un proyecto.')}`} target="_blank" rel="noopener noreferrer" class="btn btn-wa btn-lg"><Icon name="whatsapp" class="w-5 h-5" /><span data-i18n="ctaWa">Escribir por WhatsApp</span></a></li>
        <li class="ct-line"><Icon name="whatsapp" class="w-4 h-4" /><a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">{WHATSAPP_DISPLAY}</a></li>
        <li class="ct-line"><Icon name="mail" class="w-4 h-4" /><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
      </ul>
    </div>

    <form id="contact-form" class="ct-form" data-contact-form="formulario" novalidate>
      <label for="contact-name"><span data-i18n="contactName">Nombre</span>
        <input type="text" id="contact-name" name="name" required autocomplete="name" placeholder="Tu nombre" data-i18n-placeholder="contactNamePlaceholder" />
      </label>
      <label for="contact-email"><span data-i18n="contactEmail">Email</span>
        <input type="email" id="contact-email" name="email" required autocomplete="email" placeholder="tu@email.com" data-i18n-placeholder="contactEmailPlaceholder" />
      </label>
      <label for="contact-topic"><span data-i18n="contactTopic">Tipo de proyecto</span>
        <select id="contact-topic" name="topic">
          {topics.map(([v, k, l]) => <option value={v} data-i18n={k}>{l}</option>)}
        </select>
      </label>
      <label for="contact-message"><span data-i18n="contactMessage">Contanos tu idea</span>
        <textarea id="contact-message" name="message" required rows="4" placeholder="¿Qué necesitás resolver?" data-i18n-placeholder="contactMessagePlaceholder"></textarea>
      </label>
      <button type="submit" id="contact-submit" class="btn btn-dark btn-lg"><span data-i18n="contactSend">Enviar mensaje</span> <span aria-hidden="true">↗</span></button>
      <p id="contact-status" data-ct-status class="hidden" role="status" aria-live="polite"></p>
      <p class="ct-note" data-i18n="contactPrivacy">Usamos tus datos solo para responder tu consulta.</p>
    </form>
  </div>
</section>

<style>
  .contact { background: var(--mint); padding-block: clamp(55px, 7vw, 80px); }
  .ct-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(27px, 6vw, 70px); }
  .ct-lead { margin-top: 18px; max-width: 440px; color: #4d6264; }
  .ct-direct { display: grid; gap: 10px; margin: 28px 0 0; padding: 0; list-style: none; }
  .ct-direct li:first-child { margin-bottom: 6px; }
  .ct-line { display: flex; align-items: center; gap: 8px; color: #175d57; font-weight: 650; }
  .ct-line a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .ct-form { display: grid; gap: 14px; align-content: start; }
  .ct-form label { display: grid; gap: 6px; font-size: 13px; font-weight: 650; color: var(--ink); }
  .ct-form input, .ct-form textarea, .ct-form select { width: 100%; min-height: 46px; padding: 11px 12px; border: 1px solid #a9c2bb; border-radius: 6px; background: #fff; color: var(--ink); font: inherit; font-weight: 400; }
  .ct-form textarea { min-height: 110px; resize: vertical; }
  .ct-form :is(input, textarea, select):focus-visible { outline: 2px solid #176b65; outline-offset: 1px; border-color: #176b65; }
  .ct-form [aria-invalid="true"] { border-color: #b42318; }
  .ct-form .btn { justify-self: start; }
  .ct-form .btn[disabled] { opacity: .7; cursor: progress; transform: none; }
  .ct-note { font-size: 12px; color: #536969; }
  @media (max-width: 850px) { .ct-grid { grid-template-columns: 1fr; } }
</style>

<script>
  import { initContactForms } from '../../scripts/contactForm';
  initContactForms();
</script>
