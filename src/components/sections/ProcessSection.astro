---
const steps = [
  { n: '01', k: 1, title: 'Entender', desc: 'Definimos el problema, el contexto del negocio y los objetivos antes de escribir código.' },
  { n: '02', k: 2, title: 'Diseñar', desc: 'Armamos la experiencia, el alcance y la arquitectura, con foco en lo simple.' },
  { n: '03', k: 3, title: 'Desarrollar', desc: 'Construimos, probamos y publicamos en entregas cortas que podés usar.' },
  { n: '04', k: 4, title: 'Evolucionar', desc: 'Medimos el uso real y mejoramos el producto a partir de los resultados.' },
];
---
<section id="proceso" class="section process" aria-labelledby="pr-title">
  <div class="container-safe">
    <div class="sectionhead">
      <div>
        <p class="eyebrow" data-i18n="processEyebrow">05 / Cómo trabajamos</p>
        <h2 id="pr-title" class="display mt-3.5" data-i18n="processTitle">De la idea a producción.</h2>
      </div>
      <p data-i18n="processSubtitle">Un proceso claro, entregas concretas y evolución continua.</p>
    </div>
    <ol class="steps">
      {steps.map((s) => (
        <li class="step">
          <span class="num">{s.n}</span>
          <h3 class="step__title" data-i18n={`step${s.k}Title`}>{s.title}</h3>
          <p class="step__desc" data-i18n={`step${s.k}Desc`}>{s.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process { background: #101820; border-block: 1px solid var(--line); }
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; list-style: none; margin: 0; padding: 0; }
  .step { position: relative; padding-top: 20px; border-top: 2px solid #384c55; }
  .step::before { content: ''; position: absolute; top: -6px; left: 0; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
  .step__title { margin: 10px 0 6px; font-size: 22px; font-weight: 650; letter-spacing: -.02em; color: var(--text); }
  .step__desc { font-size: 14px; color: var(--muted); }
  @media (max-width: 850px) { .steps { grid-template-columns: 1fr 1fr; gap: 28px 20px; } }
  @media (max-width: 480px) {
    .steps { grid-template-columns: 1fr; gap: 0; }
    .step { border-top: 0; border-left: 2px solid #384c55; padding: 0 0 26px 22px; }
    .step::before { top: 2px; left: -6px; }
    .step__title { margin-top: 4px; font-size: 19px; }
  }
</style>
