---
import Icon from '../Icon.astro';
import { waLink } from '../../config/home';
---
<section class="section">
  <div class="container-safe">
    <div data-reveal class="cta-band">
      <div>
        <h2 class="text-2xl sm:text-3xl font-semibold text-white" data-i18n="ctaTitle">¿Lo charlamos?</h2>
        <p class="mt-2 text-slate-300 max-w-xl" data-i18n="ctaText">Contanos qué querés construir. Te respondemos por WhatsApp con los próximos pasos.</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 shrink-0">
        <a href={waLink('Hola MateLabs, quiero consultar por un proyecto.')} target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-wa">
          <Icon name="whatsapp" class="w-5 h-5 mr-2" /><span data-i18n="ctaWa">Escribir por WhatsApp</span>
        </a>
        <a href="#contacto" class="btn btn-secondary btn-lg"><span data-i18n="ctaForm">Usar el formulario</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap;
    padding: clamp(1.5rem, 4vw, 2.75rem); border-radius: 1.5rem;
    background: linear-gradient(120deg, rgba(20,184,166,.16), rgba(139,92,246,.12)); border: 1px solid rgba(20,184,166,.25); }
</style>
