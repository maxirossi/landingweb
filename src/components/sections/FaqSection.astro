---
import { faqs } from '../../config/home';
---
<section id="preguntas" class="section" aria-labelledby="fq-title">
  <div class="container-safe fq-grid">
    <div>
      <p class="eyebrow" data-i18n="fqEyebrow">06 / Preguntas frecuentes</p>
      <h2 id="fq-title" class="display mt-3.5" data-i18n="fqTitle">Lo que nos preguntan antes de empezar.</h2>
    </div>
    <div class="fq-list">
      {faqs.map((f, i) => (
        <details class="fq">
          <summary><span data-i18n={`fqQ${i}`}>{f.q.es}</span><span class="fq__plus" aria-hidden="true"></span></summary>
          <p data-i18n={`fqA${i}`}>{f.a.es}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .fq-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(28px, 5vw, 70px); align-items: start; }
  .fq-list { border-top: 1px solid var(--line); }
  .fq { border-bottom: 1px solid var(--line); }
  .fq summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.5rem; padding: 14px 0; cursor: pointer; list-style: none; font-weight: 600; font-size: 16px; color: var(--text); }
  .fq summary::-webkit-details-marker { display: none; }
  .fq summary:hover { color: var(--accent); }
  .fq p { padding-bottom: 18px; max-width: 620px; color: var(--muted); }
  .fq__plus { position: relative; width: 14px; height: 14px; flex-shrink: 0; }
  .fq__plus::before, .fq__plus::after { content: ''; position: absolute; left: 0; top: 50%; width: 100%; height: 1.5px; margin-top: -.75px; background: var(--accent); transition: transform .2s; }
  .fq__plus::after { transform: rotate(90deg); }
  .fq[open] .fq__plus::after { transform: rotate(0); }
  @media (max-width: 850px) { .fq-grid { grid-template-columns: 1fr; } }
</style>
