---
import { faqs } from '../../config/home';
---
<section id="preguntas" class="section">
  <div class="container-safe max-w-3xl">
    <div data-reveal class="text-center mb-10">
      <div class="section-line w-16 mx-auto mb-6 rounded-full"></div>
      <h2 class="text-3xl sm:text-4xl font-semibold text-white" data-i18n="fqTitle">Preguntas frecuentes</h2>
    </div>
    <div class="space-y-3">
      {faqs.map((f, i) => (
        <details data-reveal class="fq" {...(i === 0 ? { open: true } : {})}>
          <summary><span data-i18n={`fqQ${i}`}>{f.q.es}</span><span class="fq-plus" aria-hidden="true"></span></summary>
          <p class="mt-3 text-sm text-slate-400 leading-relaxed" data-i18n={`fqA${i}`}>{f.a.es}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .fq { padding: 1.1rem 1.25rem; border-radius: 1rem; background: rgba(255,255,255,0.035); border: 1px solid rgba(255,255,255,0.08); }
  .fq[open] { border-color: rgba(20,184,166,.35); }
  .fq summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; cursor: pointer; list-style: none; font-weight: 600; color: #f1f5f9; }
  .fq summary::-webkit-details-marker { display: none; }
  .fq summary:focus-visible { outline: 2px solid #14b8a6; outline-offset: 4px; border-radius: .4rem; }
  .fq-plus { position: relative; width: 1rem; height: 1rem; flex-shrink: 0; }
  .fq-plus::before, .fq-plus::after { content: ''; position: absolute; left: 0; top: 50%; width: 100%; height: 2px; margin-top: -1px; background: #2dd4bf; border-radius: 2px; transition: transform .2s; }
  .fq-plus::after { transform: rotate(90deg); }
  .fq[open] .fq-plus::after { transform: rotate(0); }
</style>
