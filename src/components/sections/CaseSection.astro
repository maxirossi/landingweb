---
import { caseStudy as c } from '../../config/home';
---
<section id="caso" class="section" aria-labelledby="cs-title">
  <div class="container-safe">
    <div class="cs">
      <div class="cs__body">
        <p class="eyebrow" data-i18n="csEyebrow">04 / Caso de cliente</p>
        <h2 id="cs-title" class="cs__title" data-i18n="csTitle">{c.title.es}</h2>
        <p class="cs__client">{c.name} · <span data-i18n="csTag">{c.tag.es}</span></p>
        <dl class="cs__steps">
          {c.steps.map((s, i) => (
            <div>
              <dt class="num" data-i18n={`csK${i}`}>{s.k.es}</dt>
              <dd data-i18n={`csV${i}`}>{s.v.es}</dd>
            </div>
          ))}
        </dl>
        <a href={c.href} target="_blank" rel="noopener noreferrer" class="link-arrow"><span data-i18n="csCta">{c.cta.es}</span> <span aria-hidden="true">↗</span></a>
      </div>
      <a href={c.href} target="_blank" rel="noopener noreferrer" class="cs__media" tabindex="-1" aria-hidden="true">
        <span class="cs__frame"><span class="cs__bar"><span class="cs__dots"></span>persianasrosario.com</span>
          <img src={c.img} srcset={`${c.img.replace('.webp', '-800.webp')} 800w, ${c.img} 1600w`} sizes="(max-width: 900px) 92vw, 560px" alt="" width="1600" height="1000" loading="lazy" decoding="async" /></span>
      </a>
    </div>
  </div>
</section>

<style>
  .cs { display: grid; grid-template-columns: .95fr 1.05fr; gap: clamp(28px, 5vw, 70px); align-items: center; }
  .cs__title { margin-top: 14px; font-size: clamp(30px, 3.4vw, 44px); line-height: 1.1; letter-spacing: -.045em; font-weight: 650; color: var(--text); }
  .cs__client { margin-top: 10px; font-size: 13px; color: var(--muted); }
  .cs__steps { display: grid; gap: 18px; margin: 28px 0; }
  .cs__steps > div { padding-top: 14px; border-top: 1px solid var(--line); }
  .cs__steps dt { text-transform: uppercase; }
  .cs__steps dd { margin: 6px 0 0; color: #d5dde2; font-size: 15px; }
  .cs__media { display: block; padding: clamp(18px, 3vw, 34px); border: 1px solid var(--line); border-radius: 12px; background: radial-gradient(ellipse at 50% 40%, #173a4a 0, #101b25 55%, #0b1016 90%); }
  .cs__frame { display: block; overflow: hidden; border-radius: 9px; border: 1px solid #c8d2d3; background: #fff; box-shadow: 0 16px 30px #0006; }
  .cs__bar { display: flex; align-items: center; gap: 6px; height: 26px; padding: 0 10px; font-size: 10px; font-weight: 700; color: #52626c; border-bottom: 1px solid #e6e9e9; }
  .cs__dots { width: 5px; height: 5px; margin-right: 22px; border-radius: 50%; background: #aab8bc; box-shadow: 8px 0 #aab8bc, 16px 0 #aab8bc; }
  .cs__frame img { display: block; width: 100%; height: auto; }
  @media (max-width: 900px) { .cs { grid-template-columns: 1fr; } .cs__media { order: -1; } }
</style>
