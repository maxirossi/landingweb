---
import Icon from '../Icon.astro';
import { caseStudy as c } from '../../config/home';
---
<section id="caso" class="section">
  <div class="container-safe">
    <div data-reveal class="cs-card">
      <a href={c.href} target="_blank" rel="noopener noreferrer" class="cs-media" tabindex="-1">
        <img src={c.img} alt="Página de inicio de Persianas Rosario" width="1600" height="1000" loading="lazy" decoding="async" />
      </a>
      <div class="cs-body">
        <span class="cs-tag" data-i18n="csTag">{c.tag.es}</span>
        <h2 class="mt-4 text-2xl sm:text-3xl font-semibold text-white leading-tight" data-i18n="csTitle">{c.title.es}</h2>
        <p class="mt-1 text-sm text-slate-500">{c.name}</p>
        <dl class="mt-6 space-y-4">
          {c.steps.map((s, i) => (
            <div class="cs-step">
              <dt class="text-xs font-semibold tracking-wide uppercase text-brand-light" data-i18n={`csK${i}`}>{s.k.es}</dt>
              <dd class="mt-1 text-sm text-slate-300 leading-relaxed" data-i18n={`csV${i}`}>{s.v.es}</dd>
            </div>
          ))}
        </dl>
        <a href={c.href} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-teal-300 hover:underline">
          <span data-i18n="csCta">{c.cta.es}</span><Icon name="external" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cs-card { display: grid; grid-template-columns: 1.1fr 1fr; overflow: hidden; border-radius: 1.5rem;
    border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.035); }
  .cs-media { display: flex; align-items: center; padding: clamp(16px, 2.5vw, 32px); background: radial-gradient(ellipse at 50% 45%, rgb(14 165 233 / 16%), transparent 72%), #0b1422; }
  .cs-media img { display: block; width: 100%; height: auto; border-radius: .7rem; filter: drop-shadow(0 14px 24px rgb(0 0 0 / 35%)); }
  .cs-body { padding: clamp(1.4rem, 3vw, 2.5rem); }
  .cs-tag { display: inline-block; font-size: .75rem; font-weight: 600; padding: .2rem .65rem; border-radius: 999px; color: #e0f2fe;
    background: rgb(14 165 233 / 20%); border: 1px solid rgb(14 165 233 / 45%); }
  .cs-step { padding-left: 1rem; border-left: 2px solid rgba(20,184,166,.35); }
  @media (max-width: 900px) { .cs-card { grid-template-columns: 1fr; } }
</style>
