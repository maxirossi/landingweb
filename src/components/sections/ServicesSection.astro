---
import Icon from '../Icon.astro';
const services = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" /></svg>`,
    href: '/servicios/desarrollo-de-software-a-medida/',
    titleKey: 'svc1Title',
    descKey: 'svc1Desc',
    title: 'Desarrollo de software a medida',
    description: 'Sistemas backend, APIs y plataformas robustas diseñadas para escalar.',
    accent: 'brand'
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" /></svg>`,
    href: '/servicios/plataformas-web-y-saas/',
    titleKey: 'svc2Title',
    descKey: 'svc2Desc',
    title: 'Plataformas web y SaaS',
    description: 'Productos digitales completos: frontend, backend y arquitectura.',
    accent: 'cyan'
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" /></svg>`,
    href: '/servicios/integracion-de-inteligencia-artificial/',
    titleKey: 'svc3Title',
    descKey: 'svc3Desc',
    title: 'Integración de inteligencia artificial',
    description: 'Automatización, agentes de IA y modelos aplicados a problemas reales.',
    accent: 'violet'
  }
];

const accentStyles: Record<string, { bg: string; border: string; glow: string }> = {
  brand:  { bg: 'rgba(20,184,166,0.1)',  border: 'rgba(20,184,166,0.2)',  glow: 'rgba(20,184,166,0.25)' },
  cyan:   { bg: 'rgba(34,211,238,0.1)',  border: 'rgba(34,211,238,0.2)',  glow: 'rgba(34,211,238,0.25)' },
  violet: { bg: 'rgba(139,92,246,0.1)',  border: 'rgba(139,92,246,0.2)', glow: 'rgba(139,92,246,0.25)' },
};
---

<section id="servicios" class="section">
  <div class="container-safe">
    <div data-reveal class="text-center max-w-2xl mx-auto mb-10">
      <div class="section-line w-16 mx-auto mb-6 rounded-full"></div>
      <h2 class="text-3xl sm:text-4xl font-semibold text-white" data-i18n="servicesTitle">
        Qué hacemos
      </h2>
      <p class="mt-4 text-slate-400" data-i18n="servicesSubtitle">
        Diseñamos y construimos software que funciona en producción.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {services.map((service, i) => {
        const a = accentStyles[service.accent];
        return (
          <div
            data-reveal
            class="service-card card card-hover group"
            style={`transition-delay: ${i * 100}ms;`}
          >
            <div
              class="card-icon w-12 h-12 rounded-xl flex items-center justify-center text-white mb-5"
              style={`background: linear-gradient(135deg, ${a.bg}, transparent); border: 1px solid ${a.border};`}
            >
              <Fragment set:html={service.icon} />
            </div>
            <h3 class="text-lg font-semibold text-white mb-3" data-i18n={service.titleKey}>{service.title}</h3>
            <p class="text-sm text-slate-400 leading-relaxed" data-i18n={service.descKey}>{service.description}</p>
            <a href={service.href} class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand-light hover:underline"><span data-i18n="svcMore">Ver el servicio</span> <Icon name="arrow" class="w-4 h-4" /></a>
          </div>
        );
      })}
    </div>
  </div>
</section>
