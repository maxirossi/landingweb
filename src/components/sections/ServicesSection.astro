---
// Servicios: cada bloque con resultado tangible, enlace al detalle y CTA.
const services = [
  { num: '01 / DEV', href: '/servicios/desarrollo-de-software-a-medida/', k: 1, title: 'Software a medida', desc: 'Sistemas internos, APIs e integraciones que se adaptan a tu operación.', result: 'Menos planillas y tareas manuales: un sistema que hace lo que tu negocio necesita.' },
  { num: '02 / WEB', href: '/servicios/plataformas-web-y-saas/', k: 2, title: 'Plataformas web y SaaS', desc: 'Productos web completos, de la idea a producción, con una base sólida para crecer.', result: 'Una plataforma lista para tus clientes, con usuarios, pagos y panel de gestión.' },
  { num: '03 / AI', href: '/servicios/integracion-de-inteligencia-artificial/', k: 3, title: 'IA y automatización', desc: 'Agentes, asistentes e integraciones inteligentes aplicadas a procesos reales.', result: 'Respuestas y tareas repetitivas resueltas solas, conectadas a tus datos.' },
];
---
<section id="servicios" class="section" aria-labelledby="svc-title">
  <div class="container-safe">
    <div class="sectionhead">
      <div>
        <p class="eyebrow" data-i18n="servicesEyebrow">02 / Lo que hacemos</p>
        <h2 id="svc-title" class="display mt-3.5" data-i18n="servicesTitle">Ingeniería al servicio de tu negocio.</h2>
      </div>
      <p data-i18n="servicesSubtitle">Desde una primera idea hasta un sistema en producción, con tecnología pensada alrededor de lo que necesitás.</p>
    </div>

    <div class="svc-grid">
      {services.map((s) => (
        <article class="svc">
          <span class="num">{s.num}</span>
          <h3 class="svc__title" data-i18n={`svc${s.k}Title`}>{s.title}</h3>
          <p class="svc__desc" data-i18n={`svc${s.k}Desc`}>{s.desc}</p>
          <p class="svc__result"><span class="svc__result-k" data-i18n="svcResult">Resultado</span> <span data-i18n={`svc${s.k}Result`}>{s.result}</span></p>
          <a href={s.href} class="link-arrow svc__link"><span data-i18n="svcMore">Ver el servicio</span> <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>

    <div class="svc-apps">
      <p><strong data-i18n="svcAppsTitle">¿Necesitás una app móvil?</strong> <span data-i18n="svcAppsText">El desarrollo de apps para Android, iOS y web, y la integración de sistemas, lo hacemos desde Apps Rosario.</span></p>
      <a href="https://desarrolloappsrosario.com/" target="_blank" rel="noopener noreferrer" class="link-arrow"><span data-i18n="svcAppsCta">Ir a Apps Rosario</span> <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-block: 1px solid var(--line); }
  .svc { display: flex; flex-direction: column; gap: 14px; padding: 30px 27px; border-right: 1px solid var(--line); }
  .svc:first-child { padding-left: 0; }
  .svc:last-child { border-right: 0; padding-right: 0; }
  .svc__title { font-size: 24px; line-height: 1.25; letter-spacing: -.03em; font-weight: 650; color: var(--text); }
  .svc__desc { color: var(--muted); }
  .svc__result { font-size: 14px; color: #d5dde2; }
  .svc__result-k { display: block; margin-bottom: 2px; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
  .svc__link { margin-top: auto; padding-top: .5rem; font-size: 13px; }
  .svc-apps { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .75rem 2rem; margin-top: 1.75rem; padding: 1.1rem 1.25rem; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--muted); font-size: 14px; }
  .svc-apps strong { color: var(--text); }
  @media (max-width: 850px) {
    .svc-grid { grid-template-columns: 1fr; }
    .svc, .svc:first-child, .svc:last-child { padding: 23px 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .svc:last-child { border-bottom: 0; }
  }
</style>
