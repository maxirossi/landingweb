---

<section id="servicios" class="section">
  <div class="container-safe">
    <!-- Section Header -->
    <div data-reveal class="text-center max-w-2xl mx-auto mb-8">
      <div class="section-line w-16 mx-auto mb-6 rounded-full"></div>
      <h2 class="text-3xl sm:text-4xl font-semibold text-white" data-i18n="servicesTitle">
        Qué hacemos
      </h2>
      <p class="mt-4 text-slate-400" data-i18n="servicesSubtitle">
        Combinamos diseño, desarrollo y tecnología para construir soluciones digitales que funcionan.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {services.map((service, i) => (
        <div data-reveal class="card card-hover" style={`transition-delay: ${i * 70}ms;`}>
          <div class="card-icon w-10 h-10 rounded-lg flex items-center justify-center text-brand mb-4" style="background: linear-gradient(135deg, rgba(20,184,166,0.12), rgba(34,211,238,0.08)); border: 1px solid rgba(20,184,166,0.2);">
            <Fragment set:html={service.icon} />
          </div>
          <h3 class="text-lg font-medium text-white mb-2" data-i18n={service.titleKey}>{service.title}</h3>
          <p class="text-sm text-slate-400 leading-relaxed" data-i18n={service.descKey}>{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
