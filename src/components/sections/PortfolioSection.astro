---
import { portfolio } from '../../config/portfolio';
---
<section id="portfolio" class="section on-light" aria-labelledby="pf-title">
  <div class="container-safe">
    <div class="sectionhead">
      <div>
        <p class="eyebrow" data-i18n="pfEyebrow">01 / Productos propios</p>
        <h2 id="pf-title" class="display mt-3.5" data-i18n="pfTitle">Construimos lo que imaginamos.</h2>
      </div>
      <p data-i18n="pfSubtitle">Productos propios en producción: entrá y probalos. Cada plataforma resuelve un problema concreto, con su identidad y su experiencia.</p>
    </div>

    <div class="pf-grid">
      {portfolio.map((p, i) => {
        const n = i + 1;
        return (
          <article id={p.id} class="pf">
            {p.id === 'mateturnos' && <><span id="mateturnos-web" class="pf-anchor"></span><span id="mateturnos-app" class="pf-anchor"></span></>}
            <a href={p.href} target="_blank" rel="noopener noreferrer" class="pf__media" tabindex="-1" aria-hidden="true">
              <img src={p.img} srcset={`${p.img.replace('.webp', '-800.webp')} 800w, ${p.img} ${p.imgW}w`} sizes="(max-width: 760px) 92vw, 580px" alt="" width={p.imgW} height={p.imgH} loading="lazy" decoding="async" class="pf__img" />
            </a>
            <div class="pf__info">
              <span class="pf__cat" data-i18n={`pf${n}Cat`}>{p.cat.es}</span>
              <h3 class="pf__name">{p.name}</h3>
              <p class="pf__desc" data-i18n={`pf${n}Desc`}>{p.desc.es}</p>
              <div class="pf__links">
                <a href={p.href} target="_blank" rel="noopener noreferrer" class="pf__cta"><span data-i18n={`pf${n}Cta`}>{p.cta.es}</span> <span aria-hidden="true">↗</span><span class="sr-only" data-i18n="pfNewTab">(se abre en una pestaña nueva)</span></a>
                {p.app && <a href={p.app.href} target="_blank" rel="noopener noreferrer" class="pf__app"><span data-i18n={`pf${n}App`}>{p.app.cta.es}</span> <span aria-hidden="true">↗</span></a>}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .pf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .pf { position: relative; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #d5dcd9; border-radius: 12px; background: #fff; transition: transform .2s, box-shadow .2s; }
  .pf:hover { transform: translateY(-3px); box-shadow: 0 14px 25px #182c2214; }
  .pf-anchor { position: absolute; top: -5rem; }
  .pf__media { display: block; overflow: hidden; border-bottom: 1px solid #e3e8e6; background: #eef1ef; }
  .pf__img { display: block; width: 100%; height: auto; }
  .pf__info { display: flex; flex-direction: column; flex: 1; padding: clamp(21px, 2.2vw, 26px); }
  .pf__cat { font-size: 11px; font-weight: 650; letter-spacing: .12em; text-transform: uppercase; color: #5d6a72; }
  .pf__name { margin: .5rem 0; font-size: clamp(24px, 2.2vw, 29px); font-weight: 700; letter-spacing: -.05em; color: var(--ink); }
  .pf__desc { max-width: 440px; color: var(--ink-muted); }
  .pf__links { display: flex; flex-direction: column; align-items: flex-start; gap: .75rem; margin-top: auto; padding-top: 1.4rem; }
  .pf__cta { font-weight: 700; font-size: 14px; color: #165c57; border-bottom: 1px solid #165c57; }
  .pf__cta:hover { color: #0d3f3b; }
  .pf__app { font-size: 13px; color: var(--ink-muted); text-decoration: underline; text-underline-offset: 3px; }
  .pf__app:hover { color: var(--ink); }
  .pf a:focus-visible { outline: 2px solid #176b65; outline-offset: 3px; }
  @media (max-width: 760px) { .pf-grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .pf, .pf:hover { transition: none; transform: none; } }
</style>
