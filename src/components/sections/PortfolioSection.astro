---
import Icon from '../Icon.astro';
import { portfolio } from '../../config/portfolio';
// Fila 1: 2 tarjetas de 6 columnas; fila 2: 3 tarjetas de 4 columnas.
const span = ['lg:col-span-6', 'lg:col-span-6', 'lg:col-span-4', 'lg:col-span-4', 'lg:col-span-4'];
---

<section id="portfolio" class="section portfolio-section">
  <div class="container-safe">
    <div data-reveal class="text-center max-w-2xl mx-auto mb-10">
      <div class="section-line w-16 mx-auto mb-6 rounded-full"></div>
      <p class="text-xs font-semibold tracking-[0.2em] text-brand-light mb-3" data-i18n="pfEyebrow">PORTFOLIO</p>
      <h2 class="text-3xl sm:text-4xl font-semibold text-white" data-i18n="pfTitle">Productos creados por MateLabs</h2>
      <p class="mt-4 text-slate-400" data-i18n="pfSubtitle">Sitios web, turnos online, una app móvil, mapas e inteligencia artificial. Explorá lo que construimos y conocé cada producto.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6">
      {portfolio.map((p, i) => {
        const n = i + 1;
        return (
          <article id={p.id} data-reveal class:list={['pf-card', span[i], i === 4 && 'md:col-span-2']} style={`--accent:${p.accent}; transition-delay:${(i % 3) * 80}ms;`}>
            <a href={p.href} target="_blank" rel="noopener noreferrer" class:list={['pf-media', p.phone && 'pf-media--phone']} tabindex="-1">
              <img src={p.img} alt={p.es.alt} width={p.imgW} height={p.imgH} loading="lazy" decoding="async" class="pf-img" />
            </a>
            <div class="pf-body">
              <div class="flex items-center justify-between gap-3 flex-wrap">
                <h3 class="text-xl font-semibold text-white">{p.name}</h3>
                <span class="pf-tag" data-i18n={`pf${n}Tag`}>{p.es.tag}</span>
              </div>
              <p class="mt-3 text-sm text-slate-400 leading-relaxed" data-i18n={`pf${n}Desc`}>{p.es.desc}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {p.es.features.map((f, j) => <li class="pf-chip" data-i18n={`pf${n}F${j + 1}`}>{f}</li>)}
              </ul>
              {p.es.note && <p class="mt-3 text-xs text-slate-500" data-i18n={`pf${n}Note`}>{p.es.note}</p>}
              <a href={p.href} target="_blank" rel="noopener noreferrer" class="pf-cta" aria-label={`${p.es.cta} — ${p.name}`}>
                <span data-i18n={`pf${n}Cta`}>{p.es.cta}</span>
                <Icon name="external" class="w-4 h-4" />
                <span class="sr-only" data-i18n="pfNewTab">(se abre en una pestaña nueva)</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  // Texto alternativo traducible de las capturas.
  import { portfolio } from '../../config/portfolio';
  const apply = () => {
    const lang = document.documentElement.lang === 'en' ? 'en' : 'es';
    portfolio.forEach((p) => {
      const img = document.querySelector<HTMLImageElement>(`#${p.id} .pf-img`);
      if (img) img.alt = p[lang].alt;
    });
  };
  apply();
  new MutationObserver(apply).observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] });
</script>

<style>
  .portfolio-section, article[id] { scroll-margin-top: 5rem; }
  .pf-card {
    display: flex; flex-direction: column; overflow: hidden;
    border-radius: 1.5rem; border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.035);
    transition: border-color .2s, transform .2s, box-shadow .2s;
  }
  .pf-card:hover, .pf-card:focus-within { border-color: color-mix(in srgb, var(--accent) 60%, transparent); box-shadow: 0 12px 40px rgba(0,0,0,0.4); }
  @media (prefers-reduced-motion: no-preference) { .pf-card:hover { transform: translateY(-3px); } }
  .pf-media { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #0b1220; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .pf-img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
  .pf-media--phone { display: grid; place-items: center; padding: 1rem 0 0; background: radial-gradient(circle at 50% 40%, rgba(37,99,235,0.25), #0b1220 70%); }
  .pf-media--phone .pf-img {
    width: auto; height: 100%; aspect-ratio: 432 / 960; max-width: 100%;
    object-fit: contain; border-radius: 1.4rem 1.4rem 0 0; border: 6px solid #1e293b; border-bottom: 0;
  }
  .pf-body { display: flex; flex-direction: column; flex: 1; padding: 1.4rem 1.5rem 1.5rem; }
  .pf-tag { font-size: .75rem; font-weight: 600; padding: .2rem .6rem; border-radius: 999px; color: #e2e8f0;
    background: color-mix(in srgb, var(--accent) 22%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent); }
  .pf-chip { font-size: .75rem; color: #cbd5e1; padding: .25rem .6rem; border-radius: .6rem; background: rgba(255,255,255,0.06); }
  .pf-cta { margin-top: auto; padding-top: 1.25rem; display: inline-flex; align-items: center; gap: .4rem; font-size: .9rem; font-weight: 600; color: #5eead4; text-decoration: none; }
  .pf-cta:hover { text-decoration: underline; }
  .pf-cta:focus-visible, .pf-media:focus-visible { outline: 2px solid #14b8a6; outline-offset: 3px; border-radius: .5rem; }
</style>
