---
import Icon from '../Icon.astro';
import { needs } from '../../config/home';
---
<section id="necesitas" class="section needs" aria-labelledby="nd-title">
  <div class="container-safe">
    <div class="sectionhead">
      <div>
        <p class="eyebrow" data-i18n="ndEyebrow">03 / Por dónde empezar</p>
        <h2 id="nd-title" class="display mt-3.5" data-i18n="ndTitle">¿Qué necesitás resolver?</h2>
      </div>
      <p data-i18n="ndSubtitle">Elegí lo que más se parece a tu caso y te llevamos al producto o servicio indicado.</p>
    </div>
    <ul class="nd-list">
      {needs.map((n, i) => (
        <li>
          <a href={n.href} class="nd" {...(n.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
            <span class="nd__icon"><Icon name={n.icon} class="w-5 h-5" /></span>
            <span class="nd__body">
              <span class="nd__title" data-i18n={`ndT${i}`}>{n.title.es}</span>
              <span class="nd__desc" data-i18n={`ndD${i}`}>{n.desc.es}</span>
              <span class="nd__cta"><span data-i18n={`ndC${i}`}>{n.cta.es}</span> <span aria-hidden="true">{n.external ? '↗' : '→'}</span></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .needs { background: #101820; border-block: 1px solid var(--line); }
  .nd-list { display: grid; grid-template-columns: repeat(3, 1fr); list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .nd-list li { border-bottom: 1px solid var(--line); }
  .nd-list li:not(:nth-child(3n)) { border-right: 1px solid var(--line); }
  .nd { display: flex; gap: 14px; height: 100%; padding: 24px 22px; transition: background-color .2s; }
  .nd:hover { background: var(--surface); }
  .nd:hover .nd__cta { text-decoration: underline; text-underline-offset: 4px; }
  .nd__icon { display: grid; place-items: center; width: 36px; height: 36px; flex-shrink: 0; border-radius: 8px; border: 1px solid var(--line); color: var(--accent); }
  .nd__body { display: flex; flex-direction: column; gap: 6px; }
  .nd__title { font-weight: 650; color: var(--text); line-height: 1.35; }
  .nd__desc { font-size: 14px; color: var(--muted); }
  .nd__cta { margin-top: 6px; font-size: 13px; font-weight: 650; color: var(--accent); }
  @media (max-width: 960px) {
    .nd-list { grid-template-columns: 1fr 1fr; }
    .nd-list li:not(:nth-child(3n)) { border-right: 0; }
    .nd-list li:nth-child(odd) { border-right: 1px solid var(--line); }
  }
  @media (max-width: 620px) {
    .nd-list { grid-template-columns: 1fr; }
    .nd-list li:nth-child(odd) { border-right: 0; }
    .nd { padding: 20px 0; }
    .nd:hover { background: transparent; }
  }
</style>
