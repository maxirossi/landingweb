---
import Icon from '../Icon.astro';
import { needs } from '../../config/home';
---
<section id="necesitas" class="section">
  <div class="container-safe">
    <div data-reveal class="text-center max-w-2xl mx-auto mb-10">
      <div class="section-line w-16 mx-auto mb-6 rounded-full"></div>
      <p class="text-xs font-semibold tracking-[0.2em] text-brand-light mb-3" data-i18n="ndEyebrow">EMPEZÁ POR ACÁ</p>
      <h2 class="text-3xl sm:text-4xl font-semibold text-white" data-i18n="ndTitle">¿Qué necesitás resolver?</h2>
      <p class="mt-4 text-slate-400" data-i18n="ndSubtitle">Elegí la opción que más se parece a tu caso y te llevamos al producto o servicio indicado.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {needs.map((n, i) => (
        <a href={n.href} data-reveal class="nd-card group" style={`transition-delay:${(i % 3) * 70}ms`} {...(n.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
          <span class="nd-icon"><Icon name={n.icon} class="w-6 h-6" /></span>
          <span class="flex-1 min-w-0">
            <span class="block text-base font-semibold text-white" data-i18n={`ndT${i}`}>{n.title.es}</span>
            <span class="block mt-1.5 text-sm text-slate-400 leading-relaxed" data-i18n={`ndD${i}`}>{n.desc.es}</span>
            <span class="nd-cta">
              <span data-i18n={`ndC${i}`}>{n.cta.es}</span>
              <Icon name={n.external ? 'external' : 'arrow'} class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
            </span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .nd-card { display: flex; gap: 1rem; padding: 1.25rem; border-radius: 1.1rem; text-decoration: none;
    background: rgba(255,255,255,0.035); border: 1px solid rgba(255,255,255,0.08); transition: border-color .2s, background-color .2s, transform .2s; }
  .nd-card:hover, .nd-card:focus-visible { border-color: rgba(20,184,166,.45); background: rgba(20,184,166,.05); }
  @media (prefers-reduced-motion: no-preference) { .nd-card:hover { transform: translateY(-2px); } }
  .nd-card:focus-visible { outline: 2px solid #14b8a6; outline-offset: 3px; }
  .nd-icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; flex-shrink: 0; border-radius: .75rem;
    background: rgba(20,184,166,.1); border: 1px solid rgba(20,184,166,.2); color: #2dd4bf; }
  .nd-cta { display: inline-flex; align-items: center; gap: .35rem; margin-top: .85rem; font-size: .875rem; font-weight: 600; color: #5eead4; }
</style>
