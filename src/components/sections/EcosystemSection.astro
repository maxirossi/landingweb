---
const projects = [
  {
    name: 'OctoMateLabs',
    typeKey: 'eco1Type',
    type: 'Plataforma SaaS',
    descKey: 'eco1Desc',
    description: 'Workspace multiagente para coordinar modelos de IA como un equipo real. Conversaciones estructuradas, memoria persistente y orquestación multi-LLM.',
    href: 'https://octomatelabs.site',
    ctaKey: 'eco1Cta',
    cta: 'Conocer más',
    tags: ['Multi-LLM', 'Agentes IA', 'Control de tokens', 'Memory'],
    accent: 'violet',
    gradient: 'from-violet-500/10 to-violet-500/5'
  },
  {
    name: 'MatesBot',
    typeKey: 'eco3Type',
    type: 'Plataforma SaaS',
    descKey: 'eco3Desc',
    description: 'Crea chatbots en minutos para guiar usuarios, automatizar conversaciones y convertir visitas en leads de forma simple y efectiva.',
    href: 'https://matesbot.site',
    ctaKey: 'eco3Cta',
    cta: 'Conocer más',
    tags: ['Chatbots', 'Leads', 'No-code', 'Widget web'],
    accent: 'emerald',
    gradient: 'from-emerald-500/10 to-emerald-500/5'
  },
  {
    name: 'MateTurnos',
    typeKey: 'eco4Type',
    type: 'Plataforma SaaS',
    descKey: 'eco4Desc',
    description: 'Sistema de turnos online para profesionales y negocios. Tus clientes reservan desde una página pública y vos gestionás todo desde un solo lugar.',
    href: 'https://mateturnos.site',
    ctaKey: 'eco4Cta',
    cta: 'Conocer más',
    tags: ['Turnos', 'Agenda', 'Reservas', 'No-code'],
    accent: 'blue',
    gradient: 'from-blue-500/10 to-blue-500/5'
  },
  {
    name: 'QuéRicoRosario',
    typeKey: 'eco2Type',
    type: 'Producto digital',
    descKey: 'eco2Desc',
    description: 'Plataforma gastronómica para Rosario. Búsqueda inteligente de restaurantes, menús y experiencias culinarias en la ciudad.',
    href: 'https://quericorosario.com',
    ctaKey: 'eco2Cta',
    cta: 'Conocer más',
    tags: ['SEO local', 'Mapas', 'Panel admin', 'Astro SSR'],
    accent: 'brand',
    gradient: 'from-brand/10 to-brand/5'
  },
  {
    name: 'Eymate',
    typeKey: 'eco5Type',
    type: 'Plataforma SaaS',
    descKey: 'eco5Desc',
    description: 'Plataforma para crear landings y sitios personales con foco en conversión. Templates editables, dominio propio, chatbot y reservas integrados.',
    href: 'https://eymate.site',
    ctaKey: 'eco5Cta',
    cta: 'Conocer más',
    tags: ['Sitios web', 'Landing builder', 'No-code', 'Dominio propio'],
    accent: 'amber',
    gradient: 'from-amber-500/10 to-amber-500/5'
  }
];
---

<section id="proyectos" class="section relative overflow-hidden">
  <div class="bg-orb w-[400px] h-[400px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-accent/[0.05]" style="animation-delay: 2s;"></div>

  <div class="container-safe relative z-10">
    <div data-reveal class="text-center max-w-2xl mx-auto mb-10">
      <div class="section-line w-16 mx-auto mb-6 rounded-full"></div>
      <h2 class="text-3xl sm:text-4xl font-semibold text-white" data-i18n="ecoTitle">
        Proyectos
      </h2>
      <p class="mt-4 text-slate-400" data-i18n="ecoSubtitle">
        No solo hacemos servicios. Construimos productos propios que funcionan en producción.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {projects.map((project, i) => {
        const colors = {
          violet: { badgeBg: 'bg-violet-500/10', badgeBorder: 'border-violet-500/20', badgeText: 'text-violet-400', tagBg: 'rgba(139,92,246,0.08)', tagBorder: 'rgba(139,92,246,0.15)', tagColor: '#a78bfa' },
          emerald: { badgeBg: 'bg-emerald-500/10', badgeBorder: 'border-emerald-500/20', badgeText: 'text-emerald-400', tagBg: 'rgba(16,185,129,0.08)', tagBorder: 'rgba(16,185,129,0.15)', tagColor: '#6ee7b7' },
          blue: { badgeBg: 'bg-blue-500/10', badgeBorder: 'border-blue-500/20', badgeText: 'text-blue-400', tagBg: 'rgba(59,130,246,0.08)', tagBorder: 'rgba(59,130,246,0.15)', tagColor: '#93c5fd' },
          brand: { badgeBg: 'bg-brand/10', badgeBorder: 'border-brand/20', badgeText: 'text-brand', tagBg: 'rgba(20,184,166,0.08)', tagBorder: 'rgba(20,184,166,0.15)', tagColor: '#5eead4' },
          amber: { badgeBg: 'bg-amber-500/10', badgeBorder: 'border-amber-500/20', badgeText: 'text-amber-400', tagBg: 'rgba(245,158,11,0.08)', tagBorder: 'rgba(245,158,11,0.15)', tagColor: '#fcd34d' },
        };
        const c = colors[project.accent] || colors.brand;
        const { badgeBg, badgeBorder, badgeText, tagBg, tagBorder, tagColor } = c;

        return (
          <a
            data-reveal
            href={project.href}
            class="group project-card card card-hover flex flex-col justify-between"
            style={`transition-delay: ${i * 100}ms;`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div>
              <span class={`inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold ${badgeBg} ${badgeBorder} ${badgeText} border mb-4`} data-i18n={project.typeKey}>
                {project.type}
              </span>
              <h3 class="text-xl font-semibold text-white mb-2">{project.name}</h3>
              <p class="text-sm text-slate-400 leading-relaxed mb-4" data-i18n={project.descKey}>{project.description}</p>

              <!-- Feature tags -->
              <div class="flex flex-wrap gap-1.5">
                {project.tags.map(tag => (
                  <span
                    class="px-2 py-0.5 rounded text-[11px] font-medium"
                    style={`background: ${tagBg}; border: 1px solid ${tagBorder}; color: ${tagColor};`}
                  >
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-6 flex items-center gap-1.5 text-sm font-medium text-slate-300 group-hover:text-white transition-colors duration-200">
              <span data-i18n={project.ctaKey}>{project.cta}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
