---
const projects = [
  {
    name: 'OctoMateLabs',
    typeKey: 'eco1Type',
    type: 'Plataforma SaaS',
    descKey: 'eco1Desc',
    description: 'Workspace multiagente para coordinar modelos de IA como un equipo real. Conversaciones estructuradas, memoria persistente y orquestación multi-LLM.',
    color: 'violet',
    href: 'https://octomatelabs.site',
    ctaKey: 'eco1Cta',
    cta: 'Conocer más'
  },
  {
    name: 'QueriCoRosario',
    typeKey: 'eco2Type',
    type: 'Producto digital',
    descKey: 'eco2Desc',
    description: 'Plataforma gastronómica para Rosario. Búsqueda inteligente de restaurantes, menús y experiencias culinarias en la ciudad.',
    color: 'brand',
    href: 'https://quericorosario.com',
    ctaKey: 'eco2Cta',
    cta: 'Conocer más'
  }
];

const colorMap: Record<string, { bg: string; border: string; text: string; hoverGlow: string }> = {
  violet: {
    bg: 'bg-violet-500/10',
    border: 'border-violet-500/20',
    text: 'text-violet-400',
    hoverGlow: 'hover:shadow-[0_20px_40px_rgba(0,0,0,.4),0_0_30px_rgba(139,92,246,0.1)]'
  },
  brand: {
    bg: 'bg-brand/10',
    border: 'border-brand/20',
    text: 'text-brand',
    hoverGlow: 'hover:shadow-[0_20px_40px_rgba(0,0,0,.4),0_0_30px_rgba(20,184,166,0.1)]'
  }
};
---

<section id="proyectos" class="section relative overflow-hidden">
  <div class="bg-orb w-[400px] h-[400px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-accent/[0.06]" style="animation-delay: 2s;"></div>

  <div class="container-safe relative z-10">
    <!-- Section Header -->
    <div data-reveal class="text-center max-w-2xl mx-auto mb-8">
      <div class="section-line w-16 mx-auto mb-6 rounded-full"></div>
      <h2 class="text-3xl sm:text-4xl font-semibold text-white" data-i18n="ecoTitle">
        Nuestro ecosistema
      </h2>
      <p class="mt-4 text-slate-400" data-i18n="ecoSubtitle">
        No solo hacemos servicios. Construimos productos propios, plataformas y herramientas que forman parte de un ecosistema vivo.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {projects.map((project, i) => {
        const colors = colorMap[project.color];
        return (
          <a
            data-reveal
            href={project.href}
            class={`group card card-hover flex flex-col justify-between ${colors.hoverGlow}`}
            style={`transition-delay: ${i * 100}ms;`}
            target={project.href.startsWith('http') ? '_blank' : undefined}
            rel={project.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            <div>
              <span class={`inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold ${colors.bg} ${colors.border} ${colors.text} border mb-4`} data-i18n={project.typeKey}>
                {project.type}
              </span>
              <h3 class="text-xl font-semibold text-white mb-2">{project.name}</h3>
              <p class="text-sm text-slate-400 leading-relaxed" data-i18n={project.descKey}>{project.description}</p>
            </div>

            <div class="mt-6 flex items-center gap-1.5 text-sm font-medium text-slate-300 group-hover:text-white transition-colors duration-200">
              <span data-i18n={project.ctaKey}>{project.cta}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
