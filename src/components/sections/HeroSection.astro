---
import Icon from '../Icon.astro';
---
<section class="hero-section relative overflow-hidden">
  <!-- Background glows — positioned to wrap around the robot -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] rounded-full" style="background: radial-gradient(ellipse, rgba(20,184,166,0.12) 0%, rgba(20,184,166,0.04) 40%, transparent 70%);"></div>
    <div class="absolute top-[20%] right-[5%] w-[500px] h-[500px] rounded-full" style="background: radial-gradient(circle, rgba(0,255,200,0.1) 0%, transparent 50%);"></div>
    <div class="absolute top-[40%] right-[15%] w-[400px] h-[400px] rounded-full" style="background: radial-gradient(circle, rgba(139,92,246,0.08) 0%, transparent 50%);"></div>
    <div class="absolute -bottom-10 -left-20 w-[400px] h-[300px] rounded-full" style="background: radial-gradient(ellipse, rgba(34,211,238,0.06) 0%, transparent 60%);"></div>
  </div>

  <!-- Animated orbs -->
  <div class="bg-orb w-[400px] h-[400px] -top-40 -left-40 bg-brand/[0.08]" style="animation-delay: 0s;"></div>
  <div class="bg-orb w-[350px] h-[350px] top-20 -right-32 bg-accent/[0.07]" style="animation-delay: 3s;"></div>
  <div class="bg-orb w-[250px] h-[250px] bottom-0 left-1/3 bg-cyan-400/[0.05]" style="animation-delay: 6s;"></div>

  <div class="container-safe relative z-10">
    <div class="hero-grid">
      <!-- Left: Content -->
      <div class="hero-content">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border text-xs font-semibold mb-6" style="background: linear-gradient(135deg, rgba(20,184,166,0.1), rgba(139,92,246,0.08)); border-color: rgba(20,184,166,0.2); color: #2dd4bf;">
          <span class="w-1.5 h-1.5 rounded-full bg-brand animate-pulse"></span>
          <span data-i18n="heroBadge">Estudio de software · Rosario, Argentina</span>
        </div>

        <h1 class="font-semibold leading-[1.08] text-4xl sm:text-5xl lg:text-6xl text-white">
          <span data-i18n="heroTitleA">Diseñamos y construimos</span>
          <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #14b8a6, #22d3ee, #8b5cf6);" data-i18n="heroTitleB">productos digitales.</span>
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-slate-400 max-w-xl leading-relaxed" data-i18n="heroSubtitle">
          Desarrollamos software a medida, plataformas web, aplicaciones móviles y soluciones con IA. Conocé nuestros productos y contanos qué querés construir.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-col sm:flex-row items-start gap-4">
          <a href="#portfolio" class="btn btn-primary btn-lg group">
            <span data-i18n="heroCta1">Ver portfolio</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a href="#contacto" class="btn btn-secondary btn-lg group">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2 transition-transform duration-200 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
            </svg>
            <span data-i18n="heroCta2">Hablemos de tu proyecto</span>
          </a>
        </div>
        <p class="mt-6 text-sm text-slate-500" data-i18n="heroBrands">Productos de MateLabs: eyMate · MateTurnos · QuericoRosario · OctoMateLabs.</p>
      </div>

      <!-- Right: pantallas reales de productos + mascota como firma -->
      <div class="hero-visual">
        <div class="shots">
          <a href="https://eymate.site/" target="_blank" rel="noopener noreferrer" class="shot shot--web" aria-label="eyMate (se abre en una pestaña nueva)">
            <img src="/images/portfolio/eymate.webp" alt="Sitios creados con eyMate, en computadora y celular" width="960" height="650" fetchpriority="high" />
          </a>
          <a href="https://play.google.com/store/apps/details?id=site.mateturnos.app" target="_blank" rel="noopener noreferrer" class="shot shot--phone" aria-label="MateTurnos App en Google Play (se abre en una pestaña nueva)">
            <img src="/images/portfolio/mateturnos-app.webp" alt="App MateTurnos para Android" width="432" height="960" />
          </a>
          <img src="/images/mascota.webp" alt="Mascota de MateLabs: un pulpo robot con un mate" width="512" height="512" class="shots__mascot" loading="eager" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section { display: flex; align-items: center; padding-top: 5.5rem; padding-bottom: 2.5rem; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; align-items: center; gap: 2rem; }
  .hero-content { max-width: 580px; }
  .hero-visual { display: flex; justify-content: center; align-items: center; position: relative; }
  .shots { position: relative; width: min(520px, 100%); aspect-ratio: 1.15; }
  .shot { position: absolute; display: block; overflow: hidden; background: #0b1220; border: 1px solid rgba(255,255,255,0.12); box-shadow: 0 24px 60px rgba(0,0,0,0.55), 0 0 40px rgba(20,184,166,0.12); transition: border-color .2s; }
  .shot:hover, .shot:focus-visible { border-color: rgba(46,230,230,0.6); }
  .shot:focus-visible { outline: 2px solid #14b8a6; outline-offset: 3px; }
  .shot img { width: 100%; height: 100%; display: block; }
  .shot--web { left: 0; top: 4%; width: 86%; aspect-ratio: 960 / 650; border-radius: 1.1rem; }
  .shot--web img { object-fit: cover; }
  .shot--phone { right: 0; bottom: 0; width: 34%; aspect-ratio: 432 / 960; border-radius: 1.6rem; border: 5px solid #1e293b; }
  .shot--phone img { object-fit: cover; }
  .shots__mascot { position: absolute; left: -2%; bottom: -2%; width: 24%; height: auto; aspect-ratio: 1; border-radius: 50%; box-shadow: 0 0 0 2px rgba(46,230,230,0.4), 0 12px 30px rgba(0,0,0,0.6), 0 0 30px rgba(46,230,230,0.25); pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) { .shots__mascot { animation: mascotFloat 4s ease-in-out infinite; } @keyframes mascotFloat { 50% { transform: translateY(-6px); } } }

  /* ── Animations (motion-gated) ── */
  @media (prefers-reduced-motion: no-preference) {
    /* Hero entrance — content fades up, robot fades in with scale */
    .hero-content {
      opacity: 0;
      animation: heroContentIn 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.1s forwards;
    }

    .hero-visual {
      opacity: 0;
      animation: heroVisualIn 1s cubic-bezier(0.4, 0, 0.2, 1) 0.3s forwards;
    }

    @keyframes heroContentIn {
      from { opacity: 0; transform: translateY(30px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes heroVisualIn {
      from { opacity: 0; transform: scale(0.92); }
      to   { opacity: 1; transform: scale(1); }
    }
  }

  /* Responsive: mobile stacks vertically, robot on top centered */
  @media (max-width: 768px) {
    .hero-section { padding-top: 5rem; padding-bottom: 2rem; }

    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-visual { margin-top: 1.5rem; }

    .hero-content {
      max-width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-content .flex {
      justify-content: center;
      align-items: center;
    }

    .hero-content p {
      max-width: 100%;
    }
  }

</style>
