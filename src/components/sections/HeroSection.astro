---
import Icon from '../Icon.astro';
import { servicios } from '../../config/nav';
// Órbita: servicios (páginas internas) y productos (enlaces externos).
const items = [
  ...servicios.map((i) => ({ label: i.label, href: i.href, icon: i.icon!, external: false, key: i.key })),
  { label: 'Mateturnos', href: 'https://mateturnos.site/', icon: 'calendar' as const, external: true, key: 'mmProj1' },
  { label: 'Apps Rosario', href: 'https://desarrolloappsrosario.com/', icon: 'phone' as const, external: true, key: 'mmProj2' },
];
---
<section class="hero-section relative overflow-hidden">
  <!-- Background glows — positioned to wrap around the robot -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] rounded-full" style="background: radial-gradient(ellipse, rgba(20,184,166,0.12) 0%, rgba(20,184,166,0.04) 40%, transparent 70%);"></div>
    <div class="absolute top-[20%] right-[5%] w-[500px] h-[500px] rounded-full" style="background: radial-gradient(circle, rgba(0,255,200,0.1) 0%, transparent 50%);"></div>
    <div class="absolute top-[40%] right-[15%] w-[400px] h-[400px] rounded-full" style="background: radial-gradient(circle, rgba(139,92,246,0.08) 0%, transparent 50%);"></div>
    <div class="absolute -bottom-10 -left-20 w-[400px] h-[300px] rounded-full" style="background: radial-gradient(ellipse, rgba(34,211,238,0.06) 0%, transparent 60%);"></div>
  </div>

  <!-- Animated orbs -->
  <div class="bg-orb w-[400px] h-[400px] -top-40 -left-40 bg-brand/[0.08]" style="animation-delay: 0s;"></div>
  <div class="bg-orb w-[350px] h-[350px] top-20 -right-32 bg-accent/[0.07]" style="animation-delay: 3s;"></div>
  <div class="bg-orb w-[250px] h-[250px] bottom-0 left-1/3 bg-cyan-400/[0.05]" style="animation-delay: 6s;"></div>

  <div class="container-safe relative z-10">
    <div class="hero-grid">
      <!-- Left: Content -->
      <div class="hero-content">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border text-xs font-semibold mb-6" style="background: linear-gradient(135deg, rgba(20,184,166,0.1), rgba(139,92,246,0.08)); border-color: rgba(20,184,166,0.2); color: #2dd4bf;">
          <span class="w-1.5 h-1.5 rounded-full bg-brand animate-pulse"></span>
          <span data-i18n="heroBadge">Software studio — Rosario, Argentina</span>
        </div>

        <!-- H1: fixed line + typewriter -->
        <h1 class="font-semibold leading-none">
          <span class="block text-4xl sm:text-5xl lg:text-6xl text-white" data-i18n="heroTitleFixed">Construimos</span>
          <span class="block mt-2 sm:mt-3 text-4xl sm:text-5xl lg:text-6xl min-h-[1.15em]">
            <span
              id="hero-typewriter"
              class="text-transparent bg-clip-text gradient-shimmer typewriter-cursor"
              style="background-image: linear-gradient(90deg, #14b8a6, #22d3ee, #8b5cf6, #14b8a6); background-size: 200% auto;"
              aria-label=""
            ></span>
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="mt-6 text-lg sm:text-xl text-slate-400 max-w-xl leading-relaxed" data-i18n="heroSubtitle">
          Diseño, desarrollo e inteligencia artificial para productos que necesitan ejecutarse de verdad. Software a medida y tecnología aplicada a negocios reales.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-col sm:flex-row items-start gap-4">
          <a href="#servicios" class="btn btn-primary btn-lg group">
            <span data-i18n="heroCta1">Ver servicios</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a href="#contacto" class="btn btn-secondary btn-lg group">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2 transition-transform duration-200 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
            </svg>
            <span data-i18n="heroCta2">Hablemos</span>
          </a>
        </div>
      </div>

      <!-- Right: mascota con anillos y órbita de servicios y productos -->
      <div class="hero-visual">
        <div class="orbit-stage">
          <div class="orbit-glow" aria-hidden="true"></div>
          <div class="orbit-dash" aria-hidden="true"></div>
          <div class="orbit-ring" aria-hidden="true"></div>
          <div class="orbit-ring orbit-ring--2" aria-hidden="true"></div>
          <img src="/images/mascota.webp" alt="Mascota de MateLabs: un pulpo robot con un mate" width="512" height="512" class="orbit-mascot" loading="eager" fetchpriority="high" />
          <nav class="orbit" aria-label="Servicios y productos de MateLabs">
            {items.map((it, i) => (
              <a class="orbit__item" href={it.href} style={`--a:${(360 / items.length) * i - 90}deg`} title={it.label} aria-label={it.label + (it.external ? ' (se abre en una pestaña nueva)' : '')} {...(it.external ? { target: '_blank', rel: 'noopener' } : {})}>
                <span class="orbit__icon"><Icon name={it.icon} class="orbit__svg" /></span>
              </a>
            ))}
          </nav>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 5rem;
    padding-bottom: 2rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 2rem;
  }

  .hero-content {
    max-width: 580px;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  /* ── Órbita: mascota + anillos + íconos de servicios y productos ── */
  .orbit-stage {
    --size: min(420px, 86vw);
    --r: calc(var(--size) * 0.46);
    position: relative;
    width: var(--size);
    aspect-ratio: 1;
  }
  .orbit-glow { position: absolute; inset: 8%; border-radius: 50%; background: radial-gradient(closest-side, rgba(46,230,230,0.3), rgba(20,184,166,0.06) 62%, transparent 74%); }
  .orbit-dash { position: absolute; inset: 2%; border-radius: 50%; border: 1px dashed rgba(46,230,230,0.25); }
  .orbit-ring {
    position: absolute; inset: 16%; border-radius: 50%;
    background: conic-gradient(from 0deg, transparent 0 55%, rgba(46,230,230,0.15) 70%, #2ee6e6 92%, #e9ffff 100%);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
    filter: drop-shadow(0 0 8px #2ee6e6);
  }
  .orbit-ring--2 { inset: 11%; opacity: 0.45; }
  .orbit-mascot {
    position: absolute; inset: 21%; width: 58%; height: 58%; border-radius: 50%;
    box-shadow: 0 0 0 2px rgba(46,230,230,0.35), 0 30px 60px rgba(0,0,0,0.6), 0 0 60px rgba(46,230,230,0.25);
  }
  .orbit { position: absolute; inset: 0; }
  .orbit__item {
    position: absolute; left: 50%; top: 50%; width: 3.5rem; height: 3.5rem; margin: -1.75rem;
    display: grid; place-items: center; border-radius: 1rem; text-decoration: none; color: #2dd4bf;
    background: rgba(8,14,28,0.9); border: 1px solid rgba(255,255,255,0.1);
    box-shadow: 0 8px 20px rgba(0,0,0,0.5), 0 0 18px rgba(20,184,166,0.15);
    transform: rotate(var(--a)) translate(var(--r)) rotate(calc(-1 * var(--a)));
    transition: box-shadow 0.2s, border-color 0.2s, color 0.2s;
  }
  .orbit__item:hover, .orbit__item:focus-visible { color: #5eead4; border-color: rgba(46,230,230,0.5); box-shadow: 0 8px 20px rgba(0,0,0,0.5), 0 0 26px rgba(46,230,230,0.4); }
  .orbit__item:focus-visible { outline: 2px solid #14b8a6; outline-offset: 3px; }
  .orbit__icon { display: grid; place-items: center; }
  .orbit__icon :global(svg) { width: 1.75rem; height: 1.75rem; }
  @media (max-width: 768px) {
    .orbit-stage { --r: calc(var(--size) * 0.45); }
    .orbit__item { width: 3rem; height: 3rem; margin: -1.5rem; }
    .orbit__icon :global(svg) { width: 1.5rem; height: 1.5rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .orbit-glow { animation: orbPulse 3.6s ease-in-out infinite; }
    .orbit-dash { animation: orbSpin 40s linear infinite; }
    .orbit-ring { animation: orbSpin 1.6s linear infinite; }
    .orbit-ring--2 { animation-duration: 2.8s; animation-direction: reverse; }
    .orbit-mascot { animation: orbFloat 4s ease-in-out infinite; }
    .orbit__item { animation: orbAround 60s linear infinite; }
    .orbit:hover .orbit__item, .orbit:focus-within .orbit__item { animation-play-state: paused; }
    @keyframes orbAround {
      from { transform: rotate(var(--a)) translate(var(--r)) rotate(calc(-1 * var(--a))); }
      to { transform: rotate(calc(var(--a) + 360deg)) translate(var(--r)) rotate(calc(-1 * var(--a) - 360deg)); }
    }
    @keyframes orbSpin { to { transform: rotate(360deg); } }
    @keyframes orbPulse { 50% { opacity: 0.6; transform: scale(1.06); } }
    @keyframes orbFloat { 50% { transform: translateY(-8px); } }
  }

  /* ── Animations (motion-gated) ── */
  @media (prefers-reduced-motion: no-preference) {
    /* Hero entrance — content fades up, robot fades in with scale */
    .hero-content {
      opacity: 0;
      animation: heroContentIn 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.1s forwards;
    }

    .hero-visual {
      opacity: 0;
      animation: heroVisualIn 1s cubic-bezier(0.4, 0, 0.2, 1) 0.3s forwards;
    }

    @keyframes heroContentIn {
      from { opacity: 0; transform: translateY(30px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes heroVisualIn {
      from { opacity: 0; transform: scale(0.92); }
      to   { opacity: 1; transform: scale(1); }
    }
  }

  /* Responsive: mobile stacks vertically, robot on top centered */
  @media (max-width: 768px) {
    .hero-section {
      min-height: auto;
      padding-top: 6rem;
      padding-bottom: 2rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-visual {
      order: -1;
      margin-bottom: 1rem;
    }

    .hero-content {
      max-width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-content .flex {
      justify-content: center;
      align-items: center;
    }

    .hero-content p {
      max-width: 100%;
    }
  }

</style>

<script>
  (function () {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── Typewriter ──
    const el = document.getElementById('hero-typewriter');
    if (!el) return;

    const phrasesEs = [
      'software a medida.',
      'plataformas web.',
      'soluciones con IA.',
      'productos digitales.',
    ];
    const phrasesEn = [
      'custom software.',
      'web platforms.',
      'AI-powered solutions.',
      'digital products.',
    ];

    function getPhrases() {
      return document.documentElement.lang === 'en' ? phrasesEn : phrasesEs;
    }

    if (prefersReduced) {
      el.textContent = getPhrases()[0];
      el.setAttribute('aria-label', getPhrases()[0]);
      el.classList.remove('typewriter-cursor');
      return;
    }

    let phraseIdx = 0;
    let charIdx = 0;
    let deleting = false;
    let timeout: ReturnType<typeof setTimeout> | null = null;

    function tick() {
      const phrases = getPhrases();
      const current = phrases[phraseIdx % phrases.length];

      if (!deleting) {
        charIdx++;
        el.textContent = current.slice(0, charIdx);
        el.setAttribute('aria-label', current);

        if (charIdx === current.length) {
          timeout = setTimeout(() => { deleting = true; tick(); }, 2400);
          return;
        }
        timeout = setTimeout(tick, 60);
      } else {
        charIdx--;
        el.textContent = current.slice(0, charIdx);

        if (charIdx === 0) {
          deleting = false;
          phraseIdx++;
          timeout = setTimeout(tick, 350);
          return;
        }
        timeout = setTimeout(tick, 35);
      }
    }

    setTimeout(tick, 700);

    const observer = new MutationObserver(() => {
      if (timeout) clearTimeout(timeout);
      charIdx = 0;
      deleting = false;
      el.textContent = '';
      setTimeout(tick, 200);
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] });
  })();
</script>
