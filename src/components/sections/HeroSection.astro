---
import { capabilities } from '../../config/home';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container-safe hero__grid">
    <div class="hero__copy">
      <p class="eyebrow" data-i18n="heroBadge">Estudio de tecnología · Rosario, AR</p>
      <h1 id="hero-title" class="hero__title">
        <span data-i18n="heroTitleA">Ideas que se convierten en</span>
        <em data-i18n="heroTitleB">tecnología.</em>
      </h1>
      <p class="hero__lead" data-i18n="heroSubtitle">Creamos software a medida, productos digitales propios y soluciones con inteligencia artificial para negocios que quieren avanzar.</p>
      <div class="hero__actions">
        <a href="#contacto" class="btn btn-primary btn-lg"><span data-i18n="heroCta1">Empezar un proyecto</span> <span aria-hidden="true">↗</span></a>
        <a href="#portfolio" class="btn btn-secondary btn-lg"><span data-i18n="heroCta2">Explorar productos</span> <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="hero__art">
      <span class="hero__index" aria-hidden="true">ML / 01</span>
      <img src="/images/mascota.webp" alt="Pulpo robot de MateLabs, la mascota oficial, con un mate" width="512" height="512" loading="eager" fetchpriority="high" decoding="async" class="hero__mascot" />
      <span class="hero__label" aria-hidden="true">MATELABS / PRODUCT ENGINEERING</span>
    </div>
  </div>
</section>

<div class="caps">
  <ul class="container-safe caps__list" aria-label="Capacidades">
    {capabilities.map((c, i) => <li class:list={[i === 0 && 'is-strong']} data-i18n={`cap${i}`}>{c.es}</li>)}
  </ul>
</div>

<style>
  .hero { padding: calc(4.5rem + clamp(48px, 7vw, 92px)) 0 clamp(40px, 6vw, 76px); border-bottom: 1px solid var(--line); overflow: hidden; }
  .hero__grid { display: grid; grid-template-columns: 1.12fr .88fr; gap: clamp(28px, 4vw, 56px); align-items: center; }
  .hero__title { margin: 1.4rem 0; max-width: 780px; font-size: clamp(44px, 6.4vw, 91px); line-height: 1.015; letter-spacing: -.065em; font-weight: 670; color: var(--text); }
  .hero__title em { font-style: normal; color: var(--accent); }
  .hero__lead { max-width: 560px; font-size: clamp(16px, 1.4vw, 18px); line-height: 1.7; color: var(--muted); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 2rem; }

  .hero__art { position: relative; aspect-ratio: 7 / 6; border: 1px solid var(--line); border-radius: 12px; overflow: hidden;
    background: radial-gradient(ellipse at center, #1d5358 0, #101d26 45%, #0b1016 77%); }
  .hero__art::before { content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(#8cb3b40b 1px, transparent 1px), linear-gradient(90deg, #8cb3b40b 1px, transparent 1px);
    background-size: 30px 30px; -webkit-mask-image: linear-gradient(black, transparent 94%); mask-image: linear-gradient(black, transparent 94%); }
  .hero__mascot { position: absolute; left: 50%; top: 47%; width: 62%; height: auto; transform: translate(-50%, -50%); filter: drop-shadow(0 22px 22px #0006); }
  .hero__index, .hero__label { position: absolute; font-size: 11px; letter-spacing: .12em; color: #8faab1; }
  .hero__index { top: 17px; right: 19px; }
  .hero__label { bottom: 20px; left: 22px; color: #b7c9ce; }

  .caps { border-bottom: 1px solid var(--line); }
  .caps__list { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 18px; padding-block: 21px; list-style: none; margin-block: 0; font-size: 13px; color: var(--muted); }
  .caps__list li::before { content: '+'; margin-right: 10px; color: var(--accent); }
  .caps__list .is-strong { color: var(--text); font-weight: 600; }

  @media (max-width: 850px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__art { aspect-ratio: auto; height: clamp(280px, 70vw, 360px); }
    .hero__mascot { width: auto; height: 82%; }
  }
  @media (max-width: 560px) {
    .caps__list { display: grid; grid-template-columns: 1fr 1fr; }
    .hero__actions .btn { flex: 1 1 auto; }
  }
</style>
