</section>

<style>
  .hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 5rem;
    padding-bottom: 2rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 2rem;
  }

  .hero-content {
    max-width: 580px;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .robot-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .robot-img {
    width: 85%;
    max-width: 400px;
    height: auto;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 0 30px rgba(0,255,200,0.2)) drop-shadow(0 20px 40px rgba(0,0,0,0.3));
  }

  .robot-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 70%;
    height: 70%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(20,184,166,0.15) 0%, rgba(139,92,246,0.08) 40%, transparent 70%);
    filter: blur(40px);
    z-index: 1;
  }

  /* ── Animations (motion-gated) ── */
  @media (prefers-reduced-motion: no-preference) {
    /* 1. Float + micro rotation */
    .robot-img {
      animation: robotFloat 6s ease-in-out infinite, robotGlow 4s ease-in-out infinite;
    }

    @keyframes robotFloat {
      0%   { transform: translateY(0) rotate(0deg); }
      50%  { transform: translateY(-12px) rotate(1deg); }
      100% { transform: translateY(0) rotate(0deg); }
    }

    /* 2. Glow pulse on drop-shadow */
    @keyframes robotGlow {
      0%   { filter: drop-shadow(0 0 30px rgba(0,255,200,0.2)) drop-shadow(0 20px 40px rgba(0,0,0,0.3)); }
      50%  { filter: drop-shadow(0 0 50px rgba(0,255,200,0.35)) drop-shadow(0 20px 40px rgba(0,0,0,0.3)); }
      100% { filter: drop-shadow(0 0 30px rgba(0,255,200,0.2)) drop-shadow(0 20px 40px rgba(0,0,0,0.3)); }
    }

    /* 3. Background glow pulse */
    .robot-glow {
      animation: bgGlowPulse 4s ease-in-out infinite;
    }

    @keyframes bgGlowPulse {
      0%   { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
      50%  { opacity: 1;   transform: translate(-50%, -50%) scale(1.05); }
      100% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
    }

    /* 4. Hero entrance — content fades up, robot fades in with scale */
    .hero-content {
      opacity: 0;
      animation: heroContentIn 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.1s forwards;
    }

    .hero-visual {
      opacity: 0;
      animation: heroVisualIn 1s cubic-bezier(0.4, 0, 0.2, 1) 0.3s forwards;
    }

    @keyframes heroContentIn {
      from { opacity: 0; transform: translateY(30px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes heroVisualIn {
      from { opacity: 0; transform: scale(0.92); }
      to   { opacity: 1; transform: scale(1); }
    }
  }

  /* Responsive: mobile stacks vertically, robot on top centered */
  @media (max-width: 768px) {
    .hero-section {
      min-height: auto;
      padding-top: 6rem;
      padding-bottom: 2rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-visual {
      order: -1;
      margin-bottom: 1rem;
    }

    .robot-img {
      width: 55%;
      max-width: 260px;
    }

    .hero-content {
      max-width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-content .flex {
      justify-content: center;
      align-items: center;
    }

    .hero-content p {
      max-width: 100%;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .robot-img {
      width: 80%;
      max-width: 320px;
    }
  }
</style>

<script>
  (function () {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── Typewriter ──
    const el = document.getElementById('hero-typewriter');
    if (!el) return;

    const phrasesEs = [
      'software a medida.',
      'plataformas web.',
      'soluciones con IA.',
      'productos digitales.',
    ];
    const phrasesEn = [
      'custom software.',
      'web platforms.',
      'AI-powered solutions.',
      'digital products.',
    ];

    function getPhrases() {
      return document.documentElement.lang === 'en' ? phrasesEn : phrasesEs;
    }

    if (prefersReduced) {
      el.textContent = getPhrases()[0];
      el.setAttribute('aria-label', getPhrases()[0]);
      el.classList.remove('typewriter-cursor');
      return;
    }

    let phraseIdx = 0;
    let charIdx = 0;
    let deleting = false;
    let timeout: ReturnType<typeof setTimeout> | null = null;

    function tick() {
      const phrases = getPhrases();
      const current = phrases[phraseIdx % phrases.length];

      if (!deleting) {
        charIdx++;
        el.textContent = current.slice(0, charIdx);
        el.setAttribute('aria-label', current);

        if (charIdx === current.length) {
          timeout = setTimeout(() => { deleting = true; tick(); }, 2400);
          return;
        }
        timeout = setTimeout(tick, 60);
      } else {
        charIdx--;
        el.textContent = current.slice(0, charIdx);

        if (charIdx === 0) {
          deleting = false;
          phraseIdx++;
          timeout = setTimeout(tick, 350);
          return;
        }
        timeout = setTimeout(tick, 35);
      }
    }

    setTimeout(tick, 700);

    const observer = new MutationObserver(() => {
      if (timeout) clearTimeout(timeout);
      charIdx = 0;
      deleting = false;
      el.textContent = '';
      setTimeout(tick, 200);
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] });
  })();
</script>
