---
// Iconografía de interfaz: Phosphor Icons (SVG locales vía @phosphor-icons/core, render estático).
import list from '@phosphor-icons/core/assets/regular/list.svg?raw';
import x from '@phosphor-icons/core/assets/regular/x.svg?raw';
import globe from '@phosphor-icons/core/assets/regular/globe.svg?raw';
import pin from '@phosphor-icons/core/assets/regular/map-pin.svg?raw';
import mail from '@phosphor-icons/core/assets/regular/envelope-simple.svg?raw';
import arrow from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';

import codeD from '@phosphor-icons/core/assets/duotone/code-duotone.svg?raw';
import stackD from '@phosphor-icons/core/assets/duotone/stack-duotone.svg?raw';
import sparkleD from '@phosphor-icons/core/assets/duotone/sparkle-duotone.svg?raw';
import chevron from '@phosphor-icons/core/assets/regular/caret-down.svg?raw';
import arrowR from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';

import calD from '@phosphor-icons/core/assets/duotone/calendar-check-duotone.svg?raw';
import phoneD from '@phosphor-icons/core/assets/duotone/device-mobile-duotone.svg?raw';

type Name = 'calendar' | 'phone' | 'code' | 'stack' | 'sparkle' | 'chevron' | 'arrow' | 'menu' | 'close' | 'globe' | 'pin' | 'mail' | 'external';
interface Props { name: Name; class?: string }
const { name, class: cls } = Astro.props;
const raw: Record<Name, string> = { calendar: calD, phone: phoneD, code: codeD, stack: stackD, sparkle: sparkleD, chevron, arrow: arrowR, menu: list, close: x, globe, pin, mail, external: arrow };
const inner = raw[name].replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---
<svg class={cls} viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false" set:html={inner} />
